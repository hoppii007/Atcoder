{
  "name": "atcoder-problem-picker",
  "displayName": "AtCoder 精進パネル",
  "description": "問題の選択（ランダム / URL）・解答タイマー・記録を1つのパネルで管理する",
  "version": "0.2.0",
  "publisher": "local",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "atcoderShojin",
          "title": "精進",
          "icon": "media/shojin.svg"
        }
      ]
    },
    "views": {
      "atcoderShojin": [
        {
          "type": "webview",
          "id": "atcoderShojin.panel",
          "name": "精進"
        }
      ]
    },
    "commands": [
      {
        "command": "atcoderShojin.open",
        "title": "AtCoder: 精進パネルを開く"
      },
      {
        "command": "atcoderPicker.pick",
        "title": "AtCoder: 未挑戦の問題をランダムに選んで開始"
      },
      {
        "command": "atcoderTimer.toggle",
        "title": "AtCoder: タイマー開始／一時停止"
      },
      {
        "command": "atcoderTimer.reset",
        "title": "AtCoder: タイマーをリセット"
      }
    ],
    "configuration": {
      "title": "AtCoder 精進パネル",
      "properties": {
        "atcoderPicker.from": {
          "type": "integer",
          "default": 212,
          "description": "ランダムピックの対象にする開始コンテスト番号（ABC）"
        },
        "atcoderPicker.to": {
          "type": "integer",
          "default": 318,
          "description": "ランダムピックの対象にする終了コンテスト番号（ABC）"
        },
        "atcoderPicker.levels": {
          "type": "string",
          "default": "cde",
          "description": "ランダムピックの対象レベル（例: cde）。problems/ に md が無いものを未挑戦とみなす"
        }
      }
    }
  }
}
