  "dijkstra": {
    "prefix": "sni_dijkstra",
    "body": [
      "//O((E+V)logV)でsからの最短経路がもとまる",
      "//負の辺があるとダメ",
      "//nextsには{cost,index}にしといてね",
      "//始点が複数あって全部の中から最短が欲しい時は、ちょっと変更して最初から全部入れるようにしたほうがいい（dijkstraは何回も呼ばないほうがいい）",
      "//辺のコストが1しかないならbfsでOK",
      "//辺のコストが0か1しかないならbfs01でOK",
      "vll dijkstra(vector<vpll> &nexts, vll starts){",
      "    struct dijk_comp{",
      "        bool operator()(const pll &p1,const pll &p2) const{",
      "            return p1.first > p2.first;",
      "        }",
      "    };",
      "    vll dijk(nexts.size(), inf);",
      "    priority_queue<pll,vector<pll>,dijk_comp> q;",
      "    for(ll s: starts){",
      "        dijk[s] = 0;",
      "        q.push({0,s});",
      "    }",
      "    while(!q.empty()){",
      "        pll now = q.top();",
      "        q.pop();",
      "        //すでに更新されていれば無視",
      "        if(now.first > dijk[now.second]) continue;",
      "        for(pll next: nexts[now.second]){",
      "            ll ncost = next.first + now.first;",
      "            if(dijk[next.second] > ncost){",
      "                dijk[next.second] = ncost;",
      "                q.push({ncost, next.second});",
      "            }",
      "        }",
      "    }",
      "    return dijk;",
      "}"
    ],
    "description": "O((E+V)logV)でsからの最短経路がもとまる"
  },
  "ext_dijkstra": {
    "prefix": "sni_ext_dijkstra",
    "body": [
      "//O((E+V)logV)でsからの最短経路がもとまる",
      "",
      "//負の辺があるとダメ",
      "//nextsには{cost,index}にしといてね",
      "//始点が複数あって全部の中から最短が欲しい時は、ちょっと変更して最初から全部入れるようにしたほうがいい（dijkstraは何回も呼ばないほうがいい）",
      "//辺のコストが1しかないならbfsでOK",
      "//辺のコストが0か1しかないならbfs01でOK",
      "struct Node {",
      "    ll energy;",
      "    ll l;",
      "    ll i,j;",
      "    bool operator < (const Node &other) const {",
      "        return tie(energy,l,i,j) < tie(other.energy,other.l,other.i,other.j);",
      "    }",
      "};",
      "map<Node,ll> ext_dijkstra(map<Node, vector<pair<ll,Node>>> &nexts, vector<Node> starts){",
      "    struct dijk_comp{",
      "        bool operator()(const pair<ll,Node> &p1,const pair<ll,Node> &p2) const{",
      "            return p1.first > p2.first;",
      "        }",
      "    };",
      "    map<Node,ll> dijk;",
      "    for(auto node: nexts) dijk[node.fst] = inf;",
      "",
      "    priority_queue<pair<ll,Node>,vector<pair<ll,Node>>,dijk_comp> q;",
      "    for(Node s: starts){",
      "        dijk[s] = 0;",
      "        q.push({0,s});",
      "    }",
      "    while(!q.empty()){",
      "        pair<ll,Node> now = q.top();",
      "        q.pop();",
      "        //すでに更新されていれば無視",
      "        if(now.first > dijk[now.second]) continue;",
      "        for(pair<ll,Node> next: nexts[now.second]){",
      "            ll ncost = next.first + now.first;",
      "            if(dijk[next.second] > ncost){",
      "                dijk[next.second] = ncost;",
      "                q.push({ncost, next.second});",
      "            }",
      "        }",
      "    }",
      "    return dijk;",
      "}"
    ],
    "description": "O((E+V)logV)でsからの最短経路がもとまる"
  },
  "find_cycle": {
    "prefix": "sni_find_cycle",
    "body": [
      "/**",
      " * @brief 有向グラフから root を起点としてサイクルを 1 つ取得",
      " * @param nexts 隣接リスト（nexts[i] は頂点 i から伸びる辺の行き先一覧）",
      " * @param root 探索の起点となる頂点",
      " * @return サイクルを構成する頂点列。cycle[0] -> cycle[1] -> ... -> cycle.back() -> cycle[0] の順に巡る。サイクルが無ければ空配列",
      " * @note 計算量: O(V + E)",
      " * @note root から到達可能なサイクルのうち 1 つだけを返す。グラフが非連結だったり root より手前にサイクルがあると検出できない",
      " * @note DFS の行きがけ順（fst）と帰りがけ順（snd）を記録し、訪問中（snd 未確定）の頂点へ戻る後退辺をサイクルとして検出する",
      " */",
      "vll find_cycle(vvll &nexts, ll root){",
      "    vpll ret(nexts.size(), {-1,-1});",
      "    ll order = 0;",
      "    vll cycle;",
      "    std::function<ll(ll)> dfs = [&](ll now){",
      "        ret[now].fst = order++;",
      "        for(ll next: nexts[now]){",
      "            if(ret[next].fst == -1){",
      "                ll result = dfs(next);",
      "                //ループを見つけて帰ってきた時",
      "                if(result != -1){",
      "                    //ループ元に辿り着いてなければ自分もループの仲間",
      "                    if(result != inf) cycle.push_back(now);",
      "                    if(result == now) return inf;",
      "                    else return result;",
      "                }",
      "            }",
      "            else{",
      "                //きたことはあって終わってないところに来たらループ！",
      "                if(ret[next].snd == -1){",
      "                    cycle.push_back(now);",
      "                    return next;",
      "                }",
      "            }",
      "        }",
      "        ret[now].snd = order;",
      "        return -1LL;",
      "    };",
      "    dfs(root);",
      "    //最後についたところから保存されるので、ループ順にするには逆にしないといけない",
      "    reverse(all(cycle));",
      "    return cycle;",
      "}"
    ],
    "description": "有向グラフから root を起点としてサイクルを 1 つ取得"
  },
  "graph": {
    "prefix": "sni_graph",
    "body": [
      "template<typename T = long long> // costの型",
      "struct Graph {",
      "    ///////////////辺の構造体↓/////////////",
      "    struct Edge{",
      "        T c;",
      "        long long u,v; // u→vの辺",
      "        // 辺同士の比較は、c → u → vの順番に比較",
      "        bool operator<(const Edge &other) const {",
      "            return tie(c,u,v) < tie(other.c, other.u, other.v);",
      "        }",
      "    };",
      "    ",
      "    /////////////メンバ変数↓///////////////",
      "    vector<vector<pair<T,long long>>> _nexts; // nexts[i] := i番目からの隣接リスト{コスト、行き先}",
      "    vector<Edge> _edges; // 辺リスト",
      "    T _total_edge_cost; // 全ての辺のコストの合計",
      "    vector<long long> _deg_in; // 全ての頂点の入次数を保持",
      "    vector<long long> _deg_out; // 全ての頂点の出次数を保持",
      "    ",
      "    //////////コンストラクタ↓////////////",
      "    Graph(long long n): _nexts(n), _total_edge_cost(0), _deg_in(n,0), _deg_out(n,0) {}",
      "    ",
      "    //////////メンバ関数↓////////////////",
      "    //コスト1の辺u → vを追加する関数",
      "    void add_edge(long long u, long long v){",
      "        add_edge(T(1), u, v);",
      "    }",
      "    //コストcの辺u → vを追加する関数",
      "    void add_edge(T c, long long u, long long v){",
      "        _nexts[u].push_back({c, v});",
      "        _edges.push_back(Edge{c, u, v});",
      "        _total_edge_cost += c;",
      "        _deg_out[u]++;",
      "        _deg_in[v]++;",
      "    }",
      "    //頂点数を返す関数",
      "    long long size_n() const {",
      "        return _nexts.size();",
      "    }",
      "    //辺の本数を返す関数",
      "    long long size_e() const {",
      "        return _edges.size();",
      "    }",
      "    // 全ての辺のコストの合計を返す",
      "    T total_edge_cost() const {",
      "        return _total_edge_cost;",
      "    }",
      "    // 辺リストを返す関数",
      "    const vector<Edge>& edges() const {",
      "        return _edges;",
      "    }",
      "    // 隣接リストを返す関数",
      "    const vector<vector<pair<T,long long>>>& nexts() const {",
      "        return _nexts;",
      "    }",
      "    // iから行ける場所の{コスト、行き先}の集合を返す関数",
      "    const vector<pair<T,long long>>& nexts(long long i) const {",
      "        return _nexts[i];",
      "    }",
      "    // 入次数配列を返す関数",
      "    const vector<long long>& deg_in() const {",
      "        return _deg_in;",
      "    }",
      "    // 頂点iの入次数を返す関数",
      "    long long deg_in(long long i) const {",
      "        return _deg_in[i];",
      "    }",
      "    // 出次数配列を返す関数",
      "    const vector<long long>& deg_out() const {",
      "        return _deg_out;",
      "    }",
      "    // 頂点iの出次数を返す関数",
      "    long long deg_out(long long i) const {",
      "        return _deg_out[i];",
      "    }",
      "};"
    ],
    "description": "辺の構造体↓/////////////"
  },
  "have_cycle": {
    "prefix": "sni_have_cycle",
    "body": [
      "/**",
      " * @brief 有向グラフの閉路判定",
      " * @param nexts 隣接リスト（nexts[i] は頂点 i から伸びる辺の行き先一覧）",
      " * @return 閉路が存在すれば true、しなければ false",
      " * @note 計算量: O(V + E)",
      " * @note DFS で訪問中（visit=true かつ finished=false）の頂点に戻る辺があれば閉路",
      " */",
      "bool have_cycle(vvll &nexts){",
      "    vb visit(nexts.size(), false);",
      "    vb finished(nexts.size(), false);",
      "",
      "    function<bool(ll)> dfs = [&](ll now){",
      "        visit[now] = true;",
      "        for(ll nxt: nexts[now]){",
      "            if(visit[nxt] == false) {",
      "                if(dfs(nxt)) return true;",
      "            }",
      "            else if(finished[nxt] == false) return true;",
      "        }",
      "        finished[now] = true;",
      "        return false;",
      "    };",
      "",
      "    rep(i, nexts.size()) if(visit[i] == false) if(dfs(i)) return true;",
      "    return false;",
      "}"
    ],
    "description": "有向グラフの閉路判定"
  },
  "in_out_degree": {
    "prefix": "sni_in_out_degree",
    "body": [
      "/**",
      " * @brief 入次数配列",
      " * @param nexts 隣接リスト（nexts[i] は頂点 i から伸びる辺の行き先一覧）",
      " * @return 各頂点の入次数を格納した配列（ret[i] = 頂点 i に入る辺の本数）",
      " * @note 計算量: O(V + E)",
      " */",
      "vll in_degrees(vvll& nexts){",
      "    ll n = nexts.size();",
      "    vll ret(n, 0);",
      "    rep(i, n) rep(j, nexts[i].size()) ret[nexts[i][j]]++;",
      "    return ret;",
      "}",
      "",
      "/**",
      " * @brief 出次数配列",
      " * @param nexts 隣接リスト（nexts[i] は頂点 i から伸びる辺の行き先一覧）",
      " * @return 各頂点の出次数を格納した配列（ret[i] = 頂点 i から出る辺の本数）",
      " * @note 計算量: O(V)",
      " */",
      "vll out_degrees(vvll& nexts){",
      "    ll n = nexts.size();",
      "    vll ret(n, 0);",
      "    rep(i, n) ret[i] = nexts[i].size();",
      "    return ret;",
      "}"
    ],
    "description": "入次数配列"
  },
  "kruskal": {
    "prefix": "sni_kruskal",
    "body": [
      "struct UnionFind {",
      "public:",
      "    vll par; // par[i]:iの親の番号　(例) par[3] = 2 : 3の親が2",
      "    vll kosu;",
      "    ll Count; //全体として何個の集合があるか",
      "    ",
      "    UnionFind(ll n) : par(n),kosu(n),Count(n) { //最初は全てが根であるとして初期化",
      "        rep(i,n){",
      "            par[i] = i;",
      "            kosu[i] = 1;",
      "        }",
      "    }",
      "",
      "    ll root(ll x) { // データxが属する木の根を再帰で得る：root(x) = {xの木の根}",
      "        if (par[x] == x) return x;",
      "        return par[x] = root(par[x]);",
      "    }",
      "",
      "    void unite(ll x, ll y) { // xとyの木を併合",
      "        ll rx = root(x); //xの根をrx",
      "        ll ry = root(y); //yの根をry",
      "        if (rx == ry) return; //xとyの根が同じ(=同じ木にある)時はそのまま",
      "        par[rx] = ry; //xとyの根",
      "        kosu[ry] += kosu[rx];",
      "        Count--;",
      "    }",
      "",
      "    bool same(ll x, ll y) { // 2つのデータx, yが属する木が同じならtrueを返す",
      "        ll rx = root(x);",
      "        ll ry = root(y);",
      "        return rx == ry;",
      "    }",
      "    ",
      "    ll size(ll x){",
      "        return kosu[root(x)];",
      "    }",
      "    ll size(){",
      "        return Count;",
      "    }",
      "};",
      "",
      "//0 ~ N-1までのグラフ（連結）の中で、最小全域木を作る",
      "// O(E log E)",
      "//無向グラフだったとしても有向グラフとして作るから、同じu,vを結ぶ編は一つしか出てこない",
      "//costの型$1（基本的にはllかdouble）",
      "//nextsは{cost,index}",
      "//実際の最小コストだけが欲しいときは、戻り値の型をllにして、minCostを返せばいい",
      "vector<vector<pair<$1,ll>>> kruskal(vector<vector<pair<$1,ll>>> &nexts){",
      "    UnionFind uf(nexts.size());",
      "    struct KruskalEdge{",
      "        ll u,v;",
      "        $1 c;",
      "    };",
      "    vector<KruskalEdge> edges;",
      "    rep(i, nexts.size()) for(pair<$1,ll> e: nexts[i]){",
      "        edges.push_back({i, e.second, e.first});",
      "    }",
      "    //trueだったら第1引数が手前に来る",
      "    //p1 < p2として作ると昇順になる",
      "    //p2 < p1として作ると降順になる",
      "    ",
      "    //sort(all(v), compf);みたいに使ってね",
      "    std::function<bool(KruskalEdge&, KruskalEdge&)> compf = [&](const KruskalEdge &p1,const KruskalEdge &p2) {",
      "        return p1.c < p2.c;",
      "    };",
      "    ",
      "    sort(all(edges), compf);",
      "    $1 minCost = 0;",
      "    vector<vector<pair<$1,ll>>> ret(nexts.size());",
      "    rep(i,edges.size()){",
      "        if(!uf.same(edges[i].u, edges[i].v)){",
      "            uf.unite(edges[i].u, edges[i].v);",
      "            minCost += edges[i].c;",
      "            ret[edges[i].u].push_back({edges[i].c, edges[i].v});",
      "        }",
      "    }",
      "    //最小コストだけがほしいならここでminCostを返す",
      "    return ret;",
      "}"
    ],
    "description": "0 ~ N-1までのグラフ（連結）の中で、最小全域木を作る"
  },
