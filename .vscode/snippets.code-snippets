      "        _deg_out[u]++;",
      "        _deg_in[v]++;",
      "    }",
      "    //頂点数を返す関数",
      "    long long size_n() const {",
      "        return _nexts.size();",
      "    }",
      "    //辺の本数を返す関数",
      "    long long size_e() const {",
