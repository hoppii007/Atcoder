    "gcds":{
        "prefix": "sni_gcds",
        "body": [
            "//複数個のgcdを求める",
            "ll gcds(vll a){",
            "    std::function<ll(ll,ll)> subGcd = [&](ll a, ll b){",
            "        ll mi = min(a,b);",
            "        ll ma = max(a,b);",
            "        a = ma;",
            "        b = mi;",
            "        ll r;",
            "        while(r=a%b){",
            "            a = b;",
            "            b = r;",
            "        }",
            "        return b;",
            "    };",
            "    ll ret = a[0];",
            "    rep(i,a.size()){",
            "        ret = subGcd(ret,a[i]);",
            "    }",
            "    return ret;",
            "}",
        ]
    },
    "lcm":{
        "prefix": "sni_lcm",
        "body": [
            "//gcd(a,b)*aが出るからオーバーフローに注意",
            "ll lcm(ll a,ll b){",
            "    std::function<ll(ll,ll)> subGcd = [&](ll a, ll b){",
            "        ll mi = min(a,b);",
            "        ll ma = max(a,b);",
            "        a = ma;",
            "        b = mi;",
            "        ll r;",
            "        while(r=a%b){",
            "            a = b;",
            "            b = r;",
            "        }",
            "        return b;",
            "    };",
            "    return a / subGcd(a,b) * b;",
            "}",
        ]
