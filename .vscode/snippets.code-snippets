  "min_dist_path": {
    "prefix": "sni_min_dist_path",
    "body": [
      "// sからgまでの、最短経路を一つ求め、返す",
      "// depends: [dijkstra]",
      "// 辿り着けない場合、空配列を返す",
      "// O(V+E + (V+E)logV)",
      "vll min_dist_path(vvpll &nexts, ll s, ll g){",
      "    vll ret(1, s);",
      "    vvpll inexts(nexts.size());",
      "    rep(i, nexts.size()) for(pll nxt: nexts[i]){",
      "        inexts[nxt.snd].pb({nxt.fst, i});",
      "    }",
      "    vll dijk = dijkstra(inexts, {g});",
      "    if(dijk[s] == inf) return vll();",
      "",
      "    while(s != g){",
      "        pll nxt = {inf, -1};",
      "        for(pll cand: nexts[s]) chmin(nxt, {dijk[cand.snd], cand.snd});",
      "        s = nxt.snd;",
      "        ret.pb(s);",
      "    }",
      "    return ret;",
      "}"
    ],
    "description": "sからgまでの、最短経路を一つ求め、返す"
  },
  "path_to_costs": {
    "prefix": "sni_path_to_costs",
    "body": [
      "// path: s -> p1 -> p2 -> ... -> gにたいして、その合計コストを計算する",
      "// O(V + E)",
      "ll path_to_costs(vvpll& nexts, vll& path){",
      "    ll ret = 0;",
      "    rep(i, (ll)path.size()-1) {",
      "        for(pll p: nexts[path[i]]) if(p.snd == path[i+1]) ret += p.fst;",
      "    }",
      "    return ret;",
      "}"
    ],
    "description": "path: s -> p1 -> p2 -> ... -> gにたいして、その合計コストを計算する"
  },
  "topological_sort": {
    "prefix": "sni_topological_sort",
    "body": [
      "//DAG（るーぷをふくんじゃだめ）に対してトポロジカルソートし、根っこが一番左にくるようにする",
      "//ループとかあったらバグるからマジやめてね",
      "vll topological_sort(vvll &nexts){",
      "    vvb canUse(nexts.size());",
      "    rep(i,nexts.size()){",
      "        rep(j,nexts[i].size()) canUse[i].push_back(true);",
      "    }",
      "",
      "    vll in(nexts.size());",
      "    rep(i,nexts.size()) for(ll next: nexts[i]) in[next]++;",
      "",
      "    //入次数が0の集合",
      "    queue<ll> s;",
      "    rep(i,nexts.size()) if(in[i] == 0) s.push(i);",
      "",
      "    vll ret;",
      "",
      "    while(!s.empty()){",
      "        ll now = s.front();",
      "        s.pop();",
      "        ret.push_back(now);",
      "",
      "        for(ll next: nexts[now]) {",
      "            in[next]--;",
      "            if(in[next] == 0) s.push(next);",
      "        }",
      "    }",
      "",
      "    return ret;",
      "}"
    ],
    "description": "DAG（るーぷをふくんじゃだめ）に対してトポロジカルソートし、根っこが一番左にくるようにする"
