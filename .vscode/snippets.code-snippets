  "lstchangesum": {
    "prefix": "sni_lst_change_sum",
    "body": [
      "// 区間変更、区間和取得",
      "// ・TとOの積が*で定義されてないとダメ",
      "// ・vector<T>のvを用意しておく",
      "using T = ll;",
      "using O = ll;",
      "const T id_t = 0;",
      "const O id_o = inf; // 現れないやつにしておく",
      "vector<pair<T,ll>> before(v.size());",
      "rep(i, v.size()) before[i] = {v[i], 1};",
      "LazySegmentTree<pair<T,ll>, O> lst(",
      "    before,",
