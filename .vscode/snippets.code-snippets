      "            while(na <= n && nb <= n && d < Frac(na,nb)){",
      "                ma = na;",
      "                mb = nb;",
      "                two *= 2;",
      "                na = ra + two * la;",
      "                nb = rb + two * lb;",
      "            }",
      "            ra = ma;",
      "            rb = mb;",
      "        }",
      "        else if(d > Frac(ma,mb)){",
