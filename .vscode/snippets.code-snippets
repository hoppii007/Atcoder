  "lazy_segment_tree": {
    "prefix": "sni_lazy_segment_tree",
    "body": [
      "//区間更新、区間クエリはこいつにおまかせ！",
      "///////注意/////////",
      "//・T,opT,idTがモノイドになっている",
      "//・O,opO,idOがモノイドになっている",
      "//・f(o,(opT(t1,t2))) = opT(f(o,t1),f(o,t2))",
      "//・f(opO(o1,o2),t) = f(o1,f(op2,t))",
      "//・f(idO,t) = t",
      "////////////////////",
      "//コンストラクタ　関数ポインタの部分は普通に関数名書くだけでOK",
      "//LazySegmentTree<T,O>(T配列、T演算、T単位元、O演算、O単位元、更新作用(OxT -> T))",
      "//LazySegmentTree<T,O>(T配列の数、T演算、T単位元、O演算、O単位元、更新作用(OxT -> T))",
      "//関数",
      "//change(int,int,O) : 閉区間を作用素oで更新",
      "//get(int,int)閉区間",
      "// 注意事項",
      "// ・opT(o1, o2)はo2が先に追加されて、左に積まれていく",
      "template<typename T,typename O>",
      "class LazySegmentTree{",
      "public:",
      "    //要素のモノイド",
      "    T idT;",
      "    T (*opT)(T,T);",
      "    vector<T> arrayT;",
      "    //作用素のモノイド（この値について作用が一つ求まる）",
      "    O idO;",
      "    O (*opO)(O,O);",
      "    vector<O> arrayO;",
      "    //作用素から作用を作り、それをtに適用する",
      "    T (*f)(O,T);",
      "    ",
      "public:",
      "    int l_child(int i){ return i*2+1; }",
      "    int r_child(int i){ return i*2+2; }",
      "    int get_parent(int i){ return (i%2 == 0) ? (i/2-1):(i/2); }",
      "    LazySegmentTree(vector<T> &v, T (*opt)(T,T),T idt, O (*opo)(O,O), O ido, T (*tf)(O,T)){",
      "        int sz = v.size();",
      "        int n = 1;",
      "        while(n < sz) n *= 2;",
      "        this->idT = idt;",
      "        this->opT = opt;",
      "        this->idO = ido;",
      "        this->opO = opo;",
      "        this->arrayT = vector<T>(2*n-1,this->idT);",
      "        this->arrayO = vector<O>(2*n-1,this->idO);",
      "        this->f = tf;",
      "        for(int i=0;i<sz;i++) this->arrayT[this->arrayT.size()/2+i] = v[i];",
      "        for(int i=this->arrayT.size()/2-1;i>=0;i--){",
      "            this->arrayT[i] = opT(this->arrayT[l_child(i)],this->arrayT[r_child(i)]);",
      "        }",
      "    }",
      "    LazySegmentTree(int a, T (*opt)(T,T),T idt, O (*opo)(O,O), O ido, T (*tf)(O,T)){",
      "        int n = 1;",
      "        while(n < a) n*= 2;",
      "        this->idT = idt;",
      "        this->opT = opt;",
      "        this->idO = ido;",
      "        this->opO = opo;",
      "        this->arrayT = vector<T>(2*n-1,this->idT);",
      "        this->arrayO = vector<O>(2*n-1,this->idO);",
      "        this->f = tf;",
      "    }",
      "    LazySegmentTree(){}",
      "    void o_update(int k,O o){",
      "        this->arrayT[k] = f(o,this->arrayT[k]);",
      "        this->arrayO[k] = opO(o,this->arrayO[k]);",
      "        //葉なら更新履歴をリセットする",
      "        if(l_child(k) >= this->arrayT.size()) this->arrayO[k] = idO;",
      "    }",
      "    //[l,r] : 更新したい閉区間",
      "    //o : 更新に使いたい作用素（[l,r]のすべてのtをf(o,t)にしたい）",
      "    //k : 自分のインデックス",
      "    //[nowL,nowR] : 自分がカバーしている閉区間",
      "    void change(int l,int r,O o,int k=0,int nowL=-1,int nowR=-1){",
      "        //親は最初から最後までカバー",
      "        if(k == 0){",
      "            nowL = 0;",
      "            nowR = this->arrayT.size()/2;",
      "        }",
      "        //自分のカバー範囲と変更範囲が全く変わらないときは何もしない",
      "        if(r < nowL || nowR < l){ return; }",
      "        //自分のカバー範囲内全部を更新するとき",
      "        if(l <= nowL && nowR <= r){",
      "            //完全にかぶる場合、値と変更履歴を更新しておく",
      "            o_update(k,o);",
      "            return;",
      "        }",
      "        //自分の中のカバー範囲の1部が被ってるとき",
      "        //自分の更新履歴を下に引き継ぐ",
      "        int lc = l_child(k);",
      "        int rc = r_child(k);",
      "        //葉じゃないときは今溜まってる更新履歴を下に伝播",
      "        if(lc < this->arrayT.size()){",
      "            o_update(lc,this->arrayO[k]);",
      "            o_update(rc,this->arrayO[k]);",
      "            this->arrayO[k] = idO;",
      "        }",
      "        change(l,r,o,lc,nowL,(nowL+nowR)/2);",
      "        change(l,r,o,rc,(nowL+nowR)/2+1,nowR);",
      "        //自分の値を更新",
      "        this->arrayT[k] = opT(arrayT[lc],arrayT[rc]);",
      "        return;",
      "    }",
      "    //o : 親までの更新履歴",
      "    T get(int l,int r,int k=0,int nowL=-1,int nowR=-1){",
      "        //親は最初から最後までカバー",
      "        if(k == 0){",
      "            nowL = 0;",
      "            nowR = this->arrayT.size()/2;",
      "        }",
      "        //カバー範囲が全く被らないときは単位元を返す",
      "        if(r < nowL || nowR < l) return this->idT;",
      "        //完全にかぶっているとき（葉の時は必ずここに来る）",
      "        if(l <= nowL && nowR <= r){",
      "            //葉なら更新は終わってるはずだから返すだけ",
      "            if(l_child(k) >= this->arrayT.size()){",
      "                return this->arrayT[k];",
      "            }",
      "            //葉じゃなくても更新が終わってるなら返す",
      "            if(this->arrayO[k] == idO){",
      "                return this->arrayT[k];",
      "            }",
      "            //葉じゃなくて更新も終わってないなら更新して一個下にだけ流して返す",
      "            o_update(l_child(k),this->arrayO[k]);",
      "            o_update(r_child(k),this->arrayO[k]);",
      "            this->arrayO[k] = idO;",
      "            return this->arrayT[k];",
      "        }",
      "        //更新履歴を下に流す",
      "        int lc = l_child(k);",
      "        int rc = r_child(k);",
      "        //葉じゃないときは更新履歴を下に伝播",
      "        if(lc < this->arrayT.size()){",
      "            o_update(lc,this->arrayO[k]);",
      "            o_update(rc,this->arrayO[k]);",
      "            this->arrayO[k] = idO;",
      "        }",
      "        T vl = get(l,r,lc,nowL,(nowL+nowR)/2);",
      "        T vr = get(l,r,rc,(nowL+nowR)/2+1,nowR);",
      "        this->arrayO[k] = idO;",
      "        this->arrayT[k] = opT(arrayT[lc],arrayT[rc]);",
      "        return opT(vl,vr);",
      "    }",
      "    // [l,r] 区間で、最も左にある condition = trueの部分を返す",
      "    // conditionは（集計結果に）単調性があること（false,false,...,false,true,true,...,true）",
      "    // 例えば、minを記録しておいてマイナスがあるかどうかのチェックみたいな",
      "    // 見つからなければ -1 を返す。",
      "    template<class Cond>",
      "    int find_first_condition(int l,int r,Cond condition_f, int k=0,int nowL=-1,int nowR=-1){",
      "        if(k == 0){",
      "            nowL = 0;",
      "            nowR = (int)this->arrayT.size()/2;",
      "        }",
      "        if(r < nowL || nowR < l) return -1; // 範囲外",
      "        if(condition_f(this->arrayT[k]) == false) return -1; // このノード内にtrueがない",
      "        if(nowL == nowR){",
      "            // 葉で、かつ m < 0 ならここ",
      "            return nowL;",
      "        }",
      "        int lc = l_child(k);",
      "        int rc = r_child(k);",
      "        // 子に遅延伝播してから探索（必要）",
      "        if(lc < (int)this->arrayT.size()){",
      "            o_update(lc,this->arrayO[k]);",
      "            o_update(rc,this->arrayO[k]);",
      "            this->arrayO[k] = idO;",
      "        }",
      "        int mid = (nowL+nowR)/2;",
      "        int res = find_first_condition(l,r,condition_f,lc,nowL,mid);",
      "        if(res != -1) return res;",
      "        return find_first_condition(l,r,condition_f,rc,mid+1,nowR);",
      "    }",
      "    void showTree(){",
      "        int n = 1;",
      "        int j=0;",
      "        while(n+j < this->arrayT.size()){",
      "            while(j < n){",
      "                cout<<\"(\"<<this->arrayT[n+j-1].first<<\",\"<<this->arrayT[n+j-1].second<<\")\"<<\"/\"<<this->arrayO[n+j-1]<<\" \";",
      "                j++;",
      "            }",
      "            cout<<endl;",
      "            n *= 2;",
      "            j = 0;",
      "        }",
      "    }",
      "};",
      "",
      "// 区間加算、区間和取得",
      "// ・TとOの積が*で定義されてないとダメ",
      "// ・vector<T>のvを用意しておく",
      "using T = ll;",
      "using O = ll;",
      "const T id_t = 0;",
      "const O id_o = 0;",
      "vector<pair<T,ll>> before(v.size());",
      "rep(i, v.size()) before[i] = {v[i], 1};",
      "LazySegmentTree<pair<T,ll>, O> lst(",
      "    before,",
      "    [](pair<T, ll> a, pair<T, ll> b){ return pair<T,ll>{a.fst+b.fst, a.snd+b.snd}; },",
      "    {id_t, 0},",
      "    [](O o_new, O o_old){ return o_new + o_old; },",
      "    id_o,",
      "    [](O o, pair<T,ll> t){ return pair<T,ll>{t.fst+o*t.snd, t.snd}; }",
      ");",
      "",
      "",
      "// 区間変更、区間和取得",
      "// ・TとOの積が*で定義されてないとダメ",
      "// ・vector<T>のvを用意しておく",
      "using T = ll;",
      "using O = ll;",
      "const T id_t = 0;",
      "const O id_o = inf; // 現れないやつにしておく",
      "vector<pair<T,ll>> before(v.size());",
      "rep(i, v.size()) before[i] = {v[i], 1};",
      "LazySegmentTree<pair<T,ll>, O> lst(",
      "    before,",
      "    [](pair<T, ll> a, pair<T, ll> b){ return pair<T,ll>{a.fst+b.fst, a.snd+b.snd}; },",
      "    {id_t, 0},",
      "    [](O o_new, O o_old){ return (o_new==id_o)?o_old:o_new; },",
      "    id_o,",
      "    [](O o, pair<T,ll> t){ return (o==id_o)?t:pair<T,ll>{o*t.snd, t.snd}; }",
      ");"
    ],
    "description": "区間更新、区間クエリはこいつにおまかせ！"
  },
  "lca_tree": {
    "prefix": "sni_lca_tree",
    "body": [
      "//一回の行き先が決まってる状態から、K回先を計算する O(N log K)",
      "//要素数:n",
      "//各状態(0 ~ n)から、2^60回までの遷移先を求める(10^18ちょいくらい)",
      "// dub[i][j] := iから2^j回遷移した先",
      "//一回の行き先をnextsに入れとく",
      "//行き先がないやつは-1",
      "vvll doubling(vll &nexts){",
      "    vvll dub(nexts.size(), vll(61));",
      "    rep(i,nexts.size()) dub[i][0] = nexts[i];",
      "    rep(j,1,61) rep(i,nexts.size()){",
      "        if(dub[i][j-1] == -1) dub[i][j] = -1;",
      "        else dub[i][j] = dub[dub[i][j-1]][j-1];",
      "    }",
      "    return dub;",
      "}",
      "",
      "//木の中で、rootからの距離を入れる",
      "//O(N)",
      "vll treeDepth(ll root, vvll &nexts){",
      "    vll ret(nexts.size(), inf);",
      "    std::function<void(ll,ll)> subDfs = [&](ll now, ll d){",
      "        ret[now] = d;",
      "        for(ll next: nexts[now]) if(ret[next] == inf) subDfs(next, d+1);",
      "    };",
      "    subDfs(root, 0);",
      "    return ret;",
      "}",
      "",
      "//木の中で、rootを指定して、各頂点のparentsを設定する",
      "//親の親は自分自身にしておく",
      "//O(N)",
      "vll treeParents(ll root, vvll &nexts){",
      "    vll ret(nexts.size(), inf);",
      "    std::function<void(ll,ll)> subDfs = [&](ll now, ll parent){",
      "        ret[now] = parent;",
      "        for(ll next: nexts[now]) if(ret[next] == inf) subDfs(next, now);",
      "    };",
      "    //親の親を-1にしたりしたいときはここの第二引数を変更",
      "    //infにするときは注意",
      "    subDfs(root, -1);",
      "    return ret;",
      "}",
      "",
      "//各頂点は0 ~ N-1の番号で管理",
      "//共通祖先をO(Log V)で出すやつ",
      "//前計算はO(V Log V)",
      "//nexts : 有向グラフにしておく（親にも子にも行けるから実質無向グラフ）",
      "struct LcaTree {",
      "public:",
      "    //親",
      "    ll root;",
      "",
      "    //parents[i] : iの親を示す（親は必ず一人だからvllでいい）",
      "    //親の親は自分自身にする",
      "    vll parents;",
      "",
      "    //根からの距離を入れる",
      "    vll distToRoot;",
      "",
      "    //iから2^j回遡ったところ",
      "    vvll backDub;",
      "",
      "    LcaTree(ll r, vvll &nexts){",
      "        //parentsとrootをセット",
      "        root = r;",
      "        parents = treeParents(root, nexts);",
      "",
      "        //rootからの距離をセット",
      "        distToRoot = treeDepth(root, nexts);",
      "",
      "        //遡る用のdubling配列を用意",
      "        backDub = dubling(parents);",
      "    }",
      "",
      "    //頂点uからn回遡りたい",
      "    ll back(ll u, ll n){",
      "        ll t = 0;",
      "        while((1LL << t) <= n){",
      "            if((1LL << t) & n){",
      "                u = backDub[u][t];",
      "                if(u == -1) return root;",
      "            }",
      "            t++;",
      "        }",
      "        return u;",
      "    }",
      "",
      "    ll lca(ll u, ll v){",
      "        //高さを揃える",
      "        if(distToRoot[u] < distToRoot[v]) v = back(v, distToRoot[v]-distToRoot[u]);",
      "        else if(distToRoot[u] > distToRoot[v]) u = back(u, distToRoot[u]-distToRoot[v]);",
      "",
      "        if(u == v) return u;",
      "",
      "        //今のu,vからx遡ったら同じになる、最小のxを求める",
      "        //dublingっぽくやる(2^i進んでも違うなら進む、をiが大きい順に繰り返す)",
      "        mrep(i,60) if(backDub[u][i] != backDub[v][i]) {",
      "            u = backDub[u][i];",
      "            v = backDub[v][i];",
      "        }",
      "        return parents[u];",
      "",
      "        //にぶんたんでやる方法もある",
      "    }",
      "",
      "    //2点間の距離",
      "    ll dist(ll u, ll v){",
      "        ll l = this->lca(u,v);",
      "        return distToRoot[u] + distToRoot[v] - 2*distToRoot[l];",
      "    }",
      "    ",
      "};"
    ],
    "description": "一回の行き先が決まってる状態から、K回先を計算する O(N log K)"
  },
  "rerooting_tree_dp": {
    "prefix": "sni_rerooting_tree_dp",
    "body": [
      "/**",
      " * @brief 全方位木DP（Rerooting Tree DP）",
      " *",
      " * 木の各頂点を根としたときの木DP結果を、全頂点について合計 O(N) で求める。",
      " * 各頂点から愚直に DFS すると O(N^2) になるが、一度だけ DFS した結果を",
      " * 左右からの累積で再利用することで O(N) で全頂点分の答えを得られる。",
      " *",
      " * @tparam T DPで扱う値の型",
      " *",
      " * コンストラクタに渡す関数:",
      " *   - aggrigate(own_value, children_combined) : 自分の値と子供たちの集計結果から、自分の部分木の値を作る",
      " *   - marge_child(acc, x)                     : 子供方向の部分木の結果を順次マージ（単位元 e から始める）",
      " *   - e                                        : marge_child の単位元",
      " *",
      " * @note marge_child は結合則を満たす必要がある（左右からの累積で組むため）。",
      " *       可換性は不要だが、左から acc に右の x をマージする向きで呼ぶ点に注意。",
      " *",
      " * メソッド:",
      " *   rootDP[v]    - 頂点 v を根としたときの木全体のDP結果",
      " *   dp[v][i]     - 頂点 v から nexts[v][i] 方向に伸びる部分木のDP結果（v を含まない側）",
      " *   dpmap[{u,v}] - 辺 u->v 方向の部分木のDP結果（dp と同内容を辺ペアで引けるようにしたもの）",
      " */",
      "template <typename T>",
      "struct RerootingTreeDP{",
      "public:",
      "    /** @brief 頂点数 */",
      "    ll n;",
      "",
      "    /** @brief dp[v][i] := 頂点 v から見て nexts[v][i] 方向に伸びる部分木のDP結果 */",
      "    vector<vector<T>> dp;",
      "",
      "    /** @brief dpmap[{u,v}] := 辺 u->v 方向（v を含む側）の部分木のDP結果 */",
      "    map<pll, T> dpmap;",
      "",
      "    /** @brief rootDP[v] := 頂点 v を根としたときの木全体のDP結果 */",
      "    vector<T> rootDP;",
      "",
      "    /** @brief 木の隣接リスト */",
      "    vvll nexts;",
      "",
      "    /** @brief 各頂点が持つ値 */",
      "    vector<T> values;",
      "",
      "    /** @brief edge_idx[i][j] := 頂点 i から頂点 j に伸びる辺は nexts[i] の何番目か */",
      "    vector<unordered_map<ll,ll>> edge_idx;",
      "",
      "    T (*marge_child)(T,T);",
      "    T (*aggrigate)(T,T);",
      "",
      "    /** @brief marge_child の単位元 */",
      "    T e;",
      "",
      "    /**",
      "     * @brief 全方位木DPを構築",
      "     * @param _nexts       木の隣接リスト",
      "     * @param _values      各頂点の値",
      "     * @param _aggrigate   (自分の値, 子供たちの集計) -> 自分の部分木の値",
      "     * @param _marge_child (累積, 次の子供) -> 累積（単位元 e から始める）",
      "     * @param _e           marge_child の単位元",
      "     */",
      "    RerootingTreeDP(const vvll& _nexts, const vector<T>& _values, T (*_aggrigate)(T,T), T(*_marge_child)(T,T), T _e): nexts(_nexts), values(_values), aggrigate(_aggrigate), marge_child(_marge_child), e(_e){",
      "        n = nexts.size();",
      "",
      "        // 逆向きの辺インデックスを引けるようにしておく",
      "        edge_idx.resize(n);",
      "        rep(i, n) rep(j, nexts[i].size()) edge_idx[i][nexts[i][j]] = j;",
      "",
      "        rootDP.resize(n);",
      "",
      "        // dp を単位元で初期化",
      "        dp.resize(n);",
      "        rep(i,n) dp[i].resize(nexts[i].size(), e);",
      "",
      "        // 頂点0を根とした通常の木DPで、根から葉に向かう辺の dp を埋める",
      "        rep(i, nexts[0].size()) setNodeDfs(0, i);",
      "",
      "        // BFSで逆向きの辺の dp と rootDP を求める",
      "        rerootingBfs();",
      "    }",
      "",
      "    /** @brief デフォルトコンストラクタ（後から代入する用） */",
      "    RerootingTreeDP(){}",
      "",
      "    /**",
      "     * @brief 通常の木DPで dp[parent][i] を求める（再帰）",
      "     * @param parent 親頂点",
      "     * @param i      nexts[parent] における今見ている子のインデックス",
      "     *",
      "     * 子供方向を先に再帰で計算してから、自分の部分木の値を集計する。",
      "     */",
      "    void setNodeDfs(ll parent, ll i){",
      "        ll now = nexts[parent][i];",
      "        T childs_value = e;",
      "        rep(ni,  nexts[now].size()){",
      "            if(nexts[now][ni] == parent) continue;",
      "            setNodeDfs(now, ni);",
      "            childs_value = marge_child(childs_value, dp[now][ni]);",
      "        }",
      "        dp[parent][i] = aggrigate(values[now], childs_value);",
      "        dpmap[pll{parent,now}] = dp[parent][i];",
      "        return;",
      "    }",
      "",
      "    /**",
      "     * @brief 根からBFSで逆向きの dp を求めつつ、rootDP も決定する",
      "     *",
      "     * 頂点 now について「子供方向の dp[now][*]」が既に求まっている状態で進む。",
      "     * 左右からの累積（left と margeR）を使うことで、",
      "     * 「now の i 番目の隣接頂点を除いた残り全部をマージした値」を O(1) で取り出せ、",
      "     * dp[next][edge_idx[next][now]]（now 側を含む向きの dp）を deg(now) 個まとめて埋められる。",
      "     */",
      "    void rerootingBfs(){",
      "",
      "        queue<ll> q;",
      "        q.push(0);",
      "",
      "        vb visit(nexts.size());",
      "        visit[0] = true;",
      "",
      "        while(q.empty() == false){",
      "            // dp[now][*] は既に求まっている。dp[*][now] の側を求めていく。",
      "",
      "            ll now = q.front();",
      "            q.pop();",
      "",
      "            // margeR[i] := i 番目より後ろの子供の dp を marge_child で連結した値",
      "            vector<T> margeR(nexts[now].size(), e);",
      "            mrep(i, (ll)nexts[now].size()-2) margeR[i] = marge_child(margeR[i+1], dp[now][i+1]);",
      "",
      "            // left := i 番目より前の子供の dp を marge_child で連結した値（ループしながら更新）",
      "            T left = e;",
      "",
      "            // 左右からの累積を使い、i 番目の隣接頂点への辺を逆向きに見たときの dp を求める",
      "            rep(i, nexts[now].size()){",
      "                ll next = nexts[now][i];",
      "                dp[next][edge_idx[next][now]] = aggrigate(values[now], marge_child(left, margeR[i]));",
      "                dpmap[pll{now,next}] = dp[next][edge_idx[next][now]];",
      "                left = marge_child(left, dp[now][i]);",
      "",
      "                // まだ訪問していない隣接頂点はキューに積む",
      "                if(visit[next] == false){",
      "                    q.push(next);",
      "                    visit[next] = true;",
      "                }",
      "            }",
      "",
      "            // now を根としたときの全体の値（left は最終的に全子供をマージした値）",
      "            rootDP[now] = aggrigate(values[now], left);",
      "        }",
      "",
      "    }",
      "",
      "};"
    ],
    "description": "全方位木DP（Rerooting Tree DP）"
  },
  "scc": {
    "prefix": "sni_scc",
    "body": [
      "\"//強連結成分ごとにid（0から）を振った配列を返す\",",
      "\"//sからの連結成分については全て処理できる\",",
      "\"vll scc(vvll &nexts){\",",
      "\"    //最終的にsccIDを格納するやつ\",",
      "\"    vll sccIds(nexts.size(),-1);\",",
      "\"\",",
      "\"    //逆辺のグラフを作成\",",
      "\"    vvll invNexts(nexts.size());\",",
      "\"    rep(i,nexts.size()){\",",
      "\"        for(ll next: nexts[i]){\",",
      "\"            invNexts[next].push_back(i);\",",
      "\"        }\",",
      "\"    }\",",
      "\"\",",
      "\"    //帰りがけ順で記録していくやつ\",",
      "\"    ll order = 0;\",",
      "\"    ll sccId = 0;\",",
      "\"    \",",
      "\"    vll orders(nexts.size());\",",
      "\"    vb visitIki(nexts.size(), false);\",",
      "\"    std::function<void(ll)> scc1 = [&](ll now){\",",
      "\"        visitIki[now] = true;\",",
      "\"        for(ll next: nexts[now]){\",",
      "\"            if(visitIki[next]) continue;\",",
      "\"            scc1(next);\",",
      "\"        }\",",
      "\"        \",",
      "\"        orders[now] = order++;\",",
      "\"    };\",",
      "\"    std::function<void(ll)> scc2 = [&](ll now){\",",
      "\"        sccIds[now] = sccId;\",",
      "\"        for(ll next: invNexts[now]){\",",
      "\"            if(sccIds[next] != -1) continue;\",",
      "\"            scc2(next);\",",
      "\"        }\",",
      "\"    };\",",
      "\"    //全部の頂点について、そこから行けるところのorderを全部記録する\",",
      "\"    rep(i, nexts.size()) if(visitIki[i] == false) scc1(i);\",",
      "\"\",",
      "\"    //{帰りがけのOrder、index}のペアを降順にソート\",",
      "\"    vpll orderIds(nexts.size());\",",
      "\"    rep(i,nexts.size()) orderIds[i] = {orders[i], i};\",",
      "\"    sort(all(orderIds));\",",
      "\"    reverse(all(orderIds));\",",
      "\"\",",
      "\"    rep(i,nexts.size()) if(sccIds[orderIds[i].second] == -1){\",",
      "\"        scc2(orderIds[i].second);\",",
      "\"        sccId++;\",",
      "\"    } \",",
      "\"    return sccIds;\",",
      "\"}\","
    ]
  },
  "segment_tree": {
    "prefix": "sni_segment_tree",
    "body": [
      "/**",
      " * @brief セグメント木（点更新・区間取得）",
      " * @tparam T 要素の型",
      " * @note 構築 O(N), 更新 O(log N), 取得 O(log N)",
      " *",
      " * コンストラクタ:",
      " *   SegmentTree<T>(vector<T>&, T (*f)(T,T), T ide)",
      " *   SegmentTree<T>(int n, T (*f)(T,T), T ide)",
      " *",
      " * メソッド:",
      " *   change(int i, T v) - i番目の要素をvに更新",
      " *   get(int l, int r)  - [l, r]の区間取得（閉区間）",
      " */",
      "template<typename T>",
      "class SegmentTree{",
      "    int n;",
      "    T ident;",
      "    vector<T> array;",
      "    T (*op)(T,T);",
      "public:",
      "    SegmentTree(vector<T> &v,T (*f)(T,T),T ide){",
      "        int sz = v.size();",
      "        this->n = 1;",
      "        while(n < sz) n *= 2;",
      "        this->array = vector<T>(2*this->n-1,ide);",
      "        this->ident = ide;",
      "        this->op = f;",
      "        for(int i=0;i<sz;i++) change(i,v[i]);",
      "    }",
      "    SegmentTree(int a,T (*f)(T,T),T ide){",
      "        this->n = 1;",
      "        while(n < a) n*= 2;",
      "        this->array = vector<T>(2*this->n-1,ide);",
      "        this->ident = ide;",
      "        this->op = f;",
      "    }",
      "    SegmentTree(){}",
      "    int l_child(int i){ return i*2+1; }",
      "    int r_child(int i){ return i*2+2; }",
      "    int get_parent(int i){ return (i%2 == 0) ? (i/2-1):(i/2); }",
      "    void change(int i,T v){",
