            "//O(√n)",
            "map<ll,ll> primefact(ll n){",
            "    ll a = 2;",
            "    map<ll,ll> ret;",
            "    if(n == 1) return ret;",
            "    while(a*a <= n){",
            "        if(n%a == 0){",
            "            n /= a;",
            "            ret[a]++;",
            "        }",
            "        else{",
            "            a++;",
            "        }",
            "    }",
            "    ret[n]++;",
            "    return ret;",
            "}",
        ]
    },
