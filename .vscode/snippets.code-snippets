      "//負の辺があるとダメ",
      "//nextsには{cost,index}にしといてね",
      "//始点が複数あって全部の中から最短が欲しい時は、ちょっと変更して最初から全部入れるようにしたほうがいい（dijkstraは何回も呼ばないほうがいい）",
      "//辺のコストが1しかないならbfsでOK",
      "//辺のコストが0か1しかないならbfs01でOK",
      "struct Node {",
      "    ll energy;",
      "    ll l;",
      "    ll i,j;",
      "    bool operator < (const Node &other) const {",
      "        return tie(energy,l,i,j) < tie(other.energy,other.l,other.i,other.j);",
      "    }",
      "};",
      "map<Node,ll> ext_dijkstra(map<Node, vector<pair<ll,Node>>> &nexts, vector<Node> starts){",
      "    struct dijk_comp{",
      "        bool operator()(const pair<ll,Node> &p1,const pair<ll,Node> &p2) const{",
      "            return p1.first > p2.first;",
      "        }",
      "    };",
      "    map<Node,ll> dijk;",
      "    for(auto node: nexts) dijk[node.fst] = inf;",
      "",
      "    priority_queue<pair<ll,Node>,vector<pair<ll,Node>>,dijk_comp> q;",
      "    for(Node s: starts){",
      "        dijk[s] = 0;",
      "        q.push({0,s});",
      "    }",
      "    while(!q.empty()){",
      "        pair<ll,Node> now = q.top();",
      "        q.pop();",
      "        //すでに更新されていれば無視",
      "        if(now.first > dijk[now.second]) continue;",
      "        for(pair<ll,Node> next: nexts[now.second]){",
      "            ll ncost = next.first + now.first;",
      "            if(dijk[next.second] > ncost){",
      "                dijk[next.second] = ncost;",
      "                q.push({ncost, next.second});",
      "            }",
      "        }",
      "    }",
      "    return dijk;",
      "}"
    ]
  },
  "01bfs": {
    "prefix": "sni_01bfs",
    "body": [
      "//O(E+V)でsからの最短経路がもとまる",
      "//変のコストが0か1しかない場合は使える",
      "//nextsには{cost,index}にしといてね",
      "//始点が複数あって全部の中から最短が欲しい時は、ちょっと変更して最初から全部入れるようにしたほうがいい（何回も呼ばないほうがいい）",
      "vll bfs01(vector<vpll> &nexts, vll starts){",
      "    vll bfs01s(nexts.size(), inf);",
      "    deque<pll> q;",
      "    for(ll s: starts){",
      "        bfs01s[s] = 0;",
      "        q.push_front({0,s});",
      "    }",
      "    while(!q.empty()){",
      "        pll now = q.front();",
      "        q.pop_front();",
      "        for(pll next: nexts[now.second]){",
      "            ll ncost = bfs01s[now.second]+next.first;",
      "            if(bfs01s[next.second] <= ncost) continue;",
      "            bfs01s[next.second] = ncost;",
      "            if(next.first == 0) q.push_front({ncost, next.second});",
      "            else q.push_back({ncost, next.second});",
      "        }",
      "    }",
      "    return bfs01s;",
      "}"
    ]
  },
  "warshallfloid": {
    "prefix": "sni_warshall_floid",
    "body": [
      "//nexts : {cost, id}",
      "//N * Nのdpを返す",
      "vvll warshallFloid(vector<vpll> &nexts){",
      "    vvll dp(nexts.size(), vll(nexts.size(),inf));",
      "    rep(i,nexts.size()) for(pll p: nexts[i]) dp[i][p.second] = p.first;",
      "    rep(k, nexts.size()) rep(i, nexts.size()) rep(j, nexts.size()) dp[i][j] = min(dp[i][j], dp[i][k] + dp[k][j]);",
      "    return dp;",
      "}"
    ]
  },
  "bellmanford": {
    "prefix": "sni_bellmanford",
    "body": [
      "//単一始点から、全頂点までの最短距離がわかる",
      "//nextsは{cost, idx}",
      "//O(|V|*|E|)",
      "//負の閉路があるか？の判定も可能",
      "//まだ試してないから怖いっす...",
      "vll bellmanFord(vvpll &nexts, vll starts){",
      "    vll ret(nexts.size(), inf);",
      "    for(ll s: starts) ret[s] = 0;",
      "    ll cnt = 0;",
      "    while(cnt < nexts.size()) {",
      "        bool isEnd = true;",
      "        rep(i,nexts.size()){",
      "            for(pll next: nexts[i]){",
      "                if(ret[next.snd] > ret[i]+next.fst){",
      "                    isEnd = false;",
      "                    ret[next.snd] = ret[i]+next.fst;",
      "                }",
      "            }",
      "        }",
      "    }",
      "    //ここでcnt == nexts.size()となっていれば負の閉路が存在する",
      "    return ret;",
      "}"
    ]
  },
  "topologicalsort": {
    "prefix": "sni_topological_sort",
    "body": [
      "//DAG（るーぷをふくんじゃだめ）に対してトポロジカルソートし、根っこが一番左にくるようにする",
      "//ループとかあったらバグるからマジやめてね",
      "vll topologicalSort(vvll &nexts){",
      "    vvb canUse(nexts.size());",
      "    rep(i,nexts.size()){",
      "        rep(j,nexts[i].size()) canUse[i].push_back(true);",
      "    }",
      "",
      "    vll in(nexts.size());",
      "    rep(i,nexts.size()) for(ll next: nexts[i]) in[next]++;",
      "",
      "    //入次数が0の集合",
      "    queue<ll> s;",
      "    rep(i,nexts.size()) if(in[i] == 0) s.push(i);",
      "",
      "    vll ret;",
      "",
      "    while(!s.empty()){",
      "        ll now = s.front();",
      "        s.pop();",
      "        ret.push_back(now);",
      "",
      "        for(ll next: nexts[now]) {",
      "            in[next]--;",
      "            if(in[next] == 0) s.push(next);",
      "        }",
      "    }",
      "",
      "    return ret;",
      "}"
    ]
  },
  "findcycle": {
    "prefix": "sni_findCycle",
    "body": [
      "// 有向グラフに対して、O（N)でサイクルを一つ返す",
      "// rootから先でサイクルがあるかを見るので、連結じゃないとか、rootより前でループしてたら判定できない",
      "// あくまで一つを返すだけ",
      "// 帰ってきた配列cycle[0] -> cycle[1] -> cycle[2] ... -> cycle[cycle.size()-1] -> cycle[0]のようにループしてる",
      "vll findCycle(vvll &nexts, ll root){",
      "    vpll ret(nexts.size(), {-1,-1});",
      "    ll order = 0;",
      "    vll cycle;",
      "    std::function<ll(ll)> dfs = [&](ll now){",
      "        ret[now].fst = order++;",
      "        for(ll next: nexts[now]){",
      "            if(ret[next].fst == -1){",
      "                ll result = dfs(next);",
      "                //ループを見つけて帰ってきた時",
      "                if(result != -1){",
      "                    //ループ元に辿り着いてなければ自分もループの仲間",
      "                    if(result != inf) cycle.push_back(now);",
      "                    if(result == now) return inf;",
      "                    else return result;",
      "                }",
      "            }",
      "            else{",
      "                //きたことはあって終わってないところに来たらループ！",
      "                if(ret[next].snd == -1){",
      "                    cycle.push_back(now);",
      "                    return next;",
      "                }",
      "            }",
      "        }",
      "        ret[now].snd = order;",
      "        return -1LL;",
      "    };",
      "    dfs(root);",
      "    //最後についたところから保存されるので、ループ順にするには逆にしないといけない",
      "    reverse(all(cycle));",
      "    return cycle;",
      "}"
    ]
  },
  //DP
  "ketaDP": {
    "prefix": "sni_ketaDP",
    "body": [
      "//Nを適当な心数表記したやつ（最上位桁が一番左）",
      "vll digits = {2,4,0,1};",
      "//dp[i桁目まで考えて（0桁目は最上位の上）][状態がjで][smaller]なやつの値",
      "ll stateNum =70;",
      "mll dp[digits.size()+1][stateNum][2];",
      "",
      "//初期化",
      "rep(i,digits.size()+1) rep(j,stateNum) rep(smaller, 2) dp[i][j][smaller] = 0;",
      "",
      "//初期値の設定",
      "//だいたい最上位の上を0固定にして、Nと完全一致が一つある、としてスタートすればいい",
      "dp[0][/*最上位の上に0が一つある状態のstate*/0][0] = 1;",
      "",
      "//digits[0]から始めるけど、dp[1]から更新、みたいな感じ",
      "rep(i,digits.size()) rep(state,stateNum) rep(smaller,2){",
      "    //何進数かでここは変わる",
      "    ll lim = (smaller==1)?1:digits[i];",
      "    rep(nd, lim+1){",
      "        //nsmallerの設定はだいたいこれ",
      "        ll nsmaller = smaller || nd < digits[i];",
      "        //nstateの設定は問題ごとにadhoc",
      "        //stateでndを選んだ時の新しいstate",
      "        ll nstate = state + nd;",
      "        //stateが変になる時、つまり遷移できない・しても意味がない時はcontinueでoK",
      "        if(nstate >= stateNum) continue;",
      "",
      "        //現状の一つのstateと、その遷移先が定まったから、あとは遷移",
      "        //dpをmllで作っとけばmodとらなくてOK",
      "        //遷移は桁和だったり、個数だったり総和だったりするから適切に足していく",
      "        //総和の場合は個数用DPと組み合わせたりする",
      "        //とにかく答えを出そうとして、そのために必要なSubDPを揃えていく感じ",
      "        dp[i+1][nstate][nsmaller] += dp[i][state][smaller];",
      "    }",
      "}"
    ]
  },
