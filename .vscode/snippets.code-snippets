    "combination":{
        "prefix": "sni_combination",
        "body": [
            "//コンビネーションを列挙 -> v_combs",
            "//コンビネーションを出すとき、どこを使ったかの情報のみを列挙 -> vb_combs",
            "class Comb{",
            "private:",
            "    //vは最初全部falseにしといてね",
            "    static void vb_combs_sub(vvb &vv, vb &v, int now_count, int now, int k){",
            "        if(now_count == k) return;",
            "        //ちょうど最後の一個を担当するとき",
            "        if(now_count == k-1){",
            "            for(int i=now;i<v.size();i++){",
            "                v[i] = true;",
            "                vv.push_back(v);",
            "                v[i] = false;",
            "            }",
            "            return;",
            "        }",
            "        //まだまだいけるとき",
            "        for(int i=now;i<v.size();i++){",
            "            v[i] = true;",
            "            vb_combs_sub(vv,v,now_count+1,i+1,k);",
            "            v[i] = false;",
            "        }",
            "    }",
            "public:",
            "    Comb(){}",
            "    //vector<bool>の中でk本trueが立つようにする",
            "    //最終的にはコンビネーションの二次元配列を作る",
            "    //bsのサイズは、nCk * nとなる",
            "    static vvb vb_combs(int n,int k){",
            "        vb b = vb(n,false);",
            "        vvb bs;",
            "        vb_combs_sub(bs,b,0,0,k);",
            "        return bs;",
            "    }",
            "",
            "    //T型の配列aのコンビネーションを列挙する",
            "    //O(nCk * n)",
            "    template<typename T>",
            "    vector<vector<T>> v_combs(vector<T> &a, int k){",
            "        vvb bs = vb_combs(a.size(),k);",
            "        vector<vector<T>> ret;",
            "        rep(i, bs.size()){",
            "            vector<T> tmp;",
            "            rep(j, bs[i].size()) if(bs[i][j]) tmp.push_back(a[j]);",
            "            ret.push_back(tmp);",
            "        }",
            "        return ret;",
            "    }",
            "};",
        ]
    },
    "mcomb":{
        "prefix": "sni_mcomb",
        "body": [
            "// 1 <= k <= n < p <= 10^7",
            "// 逆元の求め方が天才 https://drken1215.hatenablog.com/entry/2018/06/08/210000",
            "const ll MAX = 10000000;",
            "ll fac[MAX+1], inv[MAX+1], ifac[MAX+1];",
            "void mcombInit(){",
            "    fac[0] = fac[1] = 1;",
            "    ifac[0] = ifac[1] = 1;",
            "    inv[1] = 1;",
            "    rep(i,2,MAX+1){",
            "        fac[i] = fac[i-1]*i % mod;",
            "        inv[i] = (-inv[mod%i]*(mod/i))%mod;",
            "        ifac[i] = ifac[i-1]*inv[i] % mod;;",
            "        while(ifac[i] < 0) ifac[i] += mod;",
            "    }",
            "}",
            "",
            "ll mcomb(ll n, ll k){",
            "    if(n < k) return 0;",
            "    if(n < 0 || k < 0) return 0;",
            "    return fac[n]*ifac[k]%mod*ifac[n-k]%mod;",
            "}",
        ]
    },
