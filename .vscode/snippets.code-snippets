  "union_find": {
    "prefix": "sni_union_find",
    "body": [
      "/**",
      " * @brief Union-Find（素集合データ構造）",
      " * @note 各操作 ほぼ O(1)（経路圧縮あり）",
      " *",
      " * メソッド:",
      " *   root(x)       - xが属すグループの根を返す",
      " *   unite(x, y)   - xとyのグループを合併",
      " *   is_same(x, y) - x, yが同じグループか判定",
      " *   size(x)       - xが属すグループの要素数",
      " *   size()        - グループの種類数",
      " *   get_nodes(x)  - xが属すグループの要素配列の参照（vll& a = のように、参照型で受け取る）",
      " */",
      "struct UnionFind {",
      "public:",
      "\tvll par;",
      "\tvll count_size;",
      "\tll count_group;",
      "\t// その頂点を親としたグループの頂点一覧",
      "\tvvll nodes;",
      "",
      "\tUnionFind(int n) : par(n), count_size(n), count_group(n), nodes(n) {",
      "\t\tfor (int i = 0; i < n; i++) {",
      "\t\t\tpar[i] = i;",
      "\t\t\tcount_size[i] = 1;",
      "\t\t\tnodes[i].pb(i);",
      "\t\t}",
      "\t}",
      "",
      "\tll root(ll x) {",
      "\t\tif (par[x] == x) return x;",
      "\t\treturn par[x] = root(par[x]);",
      "\t}",
      "",
      "\tvoid unite(ll x, ll y) {",
      "\t\tll rx = root(x);",
      "\t\tll ry = root(y);",
      "\t\tif (rx == ry) return;",
      "",
      "\t\t// マージてく",
      "\t\t// まずは x が小さい、 y が大きいとしておく",
      "\t\tll l = x;",
      "\t\tll g = y;",
      "\t\tll rl = rx;",
      "\t\tll rg = ry;",
      "\t\tif(count_size[rg] < count_size[rl]){",
      "\t\t\tswap(l, g);",
      "\t\t\tswap(rl, rg);",
      "\t\t}",
      "",
      "\t\t// rl を rg に結合",
      "\t\tpar[rl] = rg;",
      "\t\tcount_size[rg] += count_size[rl];",
      "\t\tfor(int t: nodes[rl]){",
      "\t\t\tnodes[rg].pb(t);",
      "\t\t}",
      "\t\tnodes[rl].clear();",
      "",
      "\t\t// グループをひとつ減らす",
      "\t\tcount_group--;",
      "\t}",
      "",
      "\tbool is_same(ll x, ll y) {",
      "\t\treturn root(x) == root(y);",
      "\t}",
      "",
      "\tll size(ll x) {",
      "\t\treturn count_size[root(x)];",
      "\t}",
      "",
      "\tll size() {",
      "\t\treturn count_group;",
      "\t}",
      "",
      "\tconst vll& get_nodes(ll x) {",
      "\t\treturn nodes[root(x)];",
      "\t}",
      "};"
    ],
    "description": "Union-Find（素集合データ構造）"
  },
