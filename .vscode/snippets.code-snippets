  "doubling": {
    "prefix": "sni_doubling",
    "body": [
      "/**",
      " * @brief ダブリング（Doubling）",
      " *",
      " * 各状態から1回の遷移先が決まっているとき、任意の状態から K 回先の遷移先を高速に求める。",
      " * 前処理でダブリングテーブルを構築し、クエリごとに K のビットを見て遷移を合成する。",
      " *",
      " * @note 前処理 O(N log K), クエリ O(log K)（N = 状態数, K = 最大遷移回数）",
      " */",
      "struct Doubling{",
      "    /** @brief dub[i][j] := 状態 i から 2^j 回遷移した先（遷移先がなければ -1） */",
      "    vvll dub;",
      "",
      "    /**",
      "     * @brief ダブリングテーブルを構築する",
      "     * @param nexts 各状態からの1回の遷移先。遷移先がない場合は -1。",
      "     *              nexts のサイズが状態数 N となる。",
      "     */",
      "    Doubling(vll &nexts){",
      "        ll n = nexts.size();",
      "        dub.resize(n, vll(61));",
      "        // 2^0 = 1回の遷移先をそのまま格納",
      "        rep(i,n) dub[i][0] = nexts[i];",
      "        // 2^j 回の遷移 = 2^(j-1) 回の遷移を2回適用",
      "        rep(j,1,61) rep(i,n){",
      "            if(dub[i][j-1] == -1) dub[i][j] = -1;",
      "            else dub[i][j] = dub[dub[i][j-1]][j-1];",
      "        }",
      "    }",
      "",
      "    /**",
      "     * @brief 状態 n から k 回遷移した先を返す（単発クエリ用）",
      "     * @param n 開始状態",
      "     * @param k 遷移回数（0 <= k <= 2^60 ≒ 10^18）",
      "     * @return k 回遷移した先の状態。途中で遷移先がなくなった場合は -1。",
      "     * @note 全状態を一括で求める場合は kth_next_all を使うこと（キャッシュ効率が良い）",
      "     */",
      "    ll kth_next(ll n, ll k){",
      "        for(ll j=0;(1LL << j) <= k;j++){",
      "            if(k & (1LL << j)) n = dub[n][j];",
      "            if(n == -1) return -1;",
      "        }",
      "        return n;",
      "    }",
      "",
      "    /**",
      "     * @brief 全状態から k 回遷移した先を一括で求める",
      "     * @param k 遷移回数（0 <= k <= 2^60 ≒ 10^18）",
      "     * @return vll dest[i] := 状態 i から k 回遷移した先。遷移先がなければ -1。",
      "     * @note kth_next を N 回呼ぶよりキャッシュ効率が良く高速",
      "     */",
      "    vll kth_next_all(ll k){",
      "        ll n = dub.size();",
      "        vll cur(n);",
      "        rep(i,n) cur[i] = i;",
      "        for(ll j=0;(1LL << j) <= k;j++){",
      "            if(k & (1LL << j)){",
      "                vll nxt(n);",
      "                rep(i,n){",
      "                    if(cur[i] == -1) nxt[i] = -1;",
      "                    else nxt[i] = dub[cur[i]][j];",
      "                }",
      "                cur = nxt;",
      "            }",
      "        }",
      "        return cur;",
      "    }",
      "};"
    ],
    "description": "ダブリング（Doubling）"
  },
  "digit_dp": {
    "prefix": "sni_digit_dp",
    "body": [
      "//Nを適当な心数表記したやつ（最上位桁が一番左）",
      "vll digits = {2,4,0,1};",
      "//dp[i桁目まで考えて（0桁目は最上位の上）][状態がjで][smaller]なやつの値",
      "ll stateNum =70;",
      "mll dp[digits.size()+1][stateNum][2];",
      "",
      "//初期化",
      "rep(i,digits.size()+1) rep(j,stateNum) rep(smaller, 2) dp[i][j][smaller] = 0;",
      "",
      "//初期値の設定",
      "//だいたい最上位の上を0固定にして、Nと完全一致が一つある、としてスタートすればいい",
      "dp[0][/*最上位の上に0が一つある状態のstate*/0][0] = 1;",
      "",
      "//digits[0]から始めるけど、dp[1]から更新、みたいな感じ",
      "rep(i,digits.size()) rep(state,stateNum) rep(smaller,2){",
      "    //何進数かでここは変わる",
      "    ll lim = (smaller==1)?1:digits[i];",
      "    rep(nd, lim+1){",
      "        //nsmallerの設定はだいたいこれ",
      "        ll nsmaller = smaller || nd < digits[i];",
      "        //nstateの設定は問題ごとにadhoc",
      "        //stateでndを選んだ時の新しいstate",
      "        ll nstate = state + nd;",
      "        //stateが変になる時、つまり遷移できない・しても意味がない時はcontinueでoK",
      "        if(nstate >= stateNum) continue;",
      "",
      "        //現状の一つのstateと、その遷移先が定まったから、あとは遷移",
      "        //dpをmllで作っとけばmodとらなくてOK",
      "        //遷移は桁和だったり、個数だったり総和だったりするから適切に足していく",
      "        //総和の場合は個数用DPと組み合わせたりする",
      "        //とにかく答えを出そうとして、そのために必要なSubDPを揃えていく感じ",
      "        dp[i+1][nstate][nsmaller] += dp[i][state][smaller];",
      "    }",
      "}"
    ],
    "description": "Nを適当な心数表記したやつ（最上位桁が一番左）"
  },
