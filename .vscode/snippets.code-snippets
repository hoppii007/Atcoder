    "dijkstra":{
        "prefix": "sni_dijkstra",
        "body": [
            "//O((E+V)logV)でsからの最短経路がもとまる",
            "//負の辺があるとダメ",
            "//nextsには{cost,index}にしといてね",
            "//始点が複数あって全部の中から最短が欲しい時は、ちょっと変更して最初から全部入れるようにしたほうがいい（dijkstraは何回も呼ばないほうがいい）",
            "//辺のコストが1しかないならbfsでOK",
            "//辺のコストが0か1しかないならbfs01でOK",
            "vll dijkstra(vector<vpll> &nexts, vll starts){",
            "    struct dijk_comp{",
            "        bool operator()(const pll &p1,const pll &p2) const{",
            "            return p1.first > p2.first;",
            "        }",
            "    };",
            "    vll dijk(nexts.size(), inf);",
            "    priority_queue<pll,vector<pll>,dijk_comp> q;",
            "    for(ll s: starts){",
            "        dijk[s] = 0;",
            "        q.push({0,s});",
            "    }",
            "    while(!q.empty()){",
            "        pll now = q.top();",
            "        q.pop();",
            "        //すでに更新されていれば無視",
            "        if(now.first > dijk[now.second]) continue;",
            "        for(pll next: nexts[now.second]){",
            "            ll ncost = next.first + now.first;",
            "            if(dijk[next.second] > ncost){",
            "                dijk[next.second] = ncost;",
            "                q.push({ncost, next.second});",
            "            }",
            "        }",
            "    }",
            "    return dijk;",
            "}",
        ]
    },
    "01bfs":{
        "prefix": "sni_01bfs",
        "body": [
            "//O(E+V)でsからの最短経路がもとまる",
            "//変のコストが0か1しかない場合は使える",
            "//nextsには{cost,index}にしといてね",
            "//始点が複数あって全部の中から最短が欲しい時は、ちょっと変更して最初から全部入れるようにしたほうがいい（何回も呼ばないほうがいい）",
            "vll bfs01(vector<vpll> &nexts, vll starts){",
            "    vll bfs01s(nexts.size(), inf);",
            "    deque<pll> q;",
            "    for(ll s: starts){",
            "        bfs01s[s] = 0;",
            "        q.push_front({0,s});",
            "    }",
            "    while(!q.empty()){",
            "        pll now = q.front();",
            "        q.pop_front();",
            "        for(pll next: nexts[now.second]){",
            "            ll ncost = bfs01s[now.second]+next.first;",
            "            if(bfs01s[next.second] <= ncost) continue;",
            "            bfs01s[next.second] = ncost;",
            "            if(next.first == 0) q.push_front({ncost, next.second});",
            "            else q.push_back({ncost, next.second});",
            "        }",
            "    }",
            "    return bfs01s;",
            "}",
        ]
    },
    "warshallfloid":{
        "prefix": "sni_warshall_floid",
        "body": [
            "//nexts : {cost, id}",
            "//N * Nのdpを返す",
            "vvll warshallFloid(vector<vpll> &nexts){",
            "    vvll dp(nexts.size(), vll(nexts.size(),inf));",
            "    rep(i,nexts.size()) for(pll p: nexts[i]) dp[i][p.second] = p.first;",
            "    rep(k, nexts.size()) rep(i, nexts.size()) rep(j, nexts.size()) dp[i][j] = min(dp[i][j], dp[i][k] + dp[k][j]);",
            "    return dp;",
            "}",
        ]
    },
    "bellmanford":{
        "prefix": "sni_bellmanford",
        "body": [
            "//単一始点から、全頂点までの最短距離がわかる",
            "//nextsは{cost, idx}",
            "//O(|V|*|E|)",
            "//負の閉路があるか？の判定も可能",
            "//まだ試してないから怖いっす...",
            "vll bellmanFord(vvpll &nexts, vll starts){",
            "    vll ret(nexts.size(), inf);",
            "    for(ll s: starts) ret[s] = 0;",
            "    ll cnt = 0;",
            "    while(cnt < nexts.size()) {",
            "        bool isEnd = true;",
            "        rep(i,nexts.size()){",
            "            for(pll next: nexts[i]){",
            "                if(ret[next.snd] > ret[i]+next.fst){",
            "                    isEnd = false;",
            "                    ret[next.snd] = ret[i]+next.fst;",
            "                }",
            "            }",
            "        }",
            "    }",
            "    //ここでcnt == nexts.size()となっていれば負の閉路が存在する",
            "    return ret;",
            "}",
        ]
    },
