  "gcd_lcm": {
    "prefix": "sni_gcd_lcm",
    "body": [
      "#include<bits/stdc++.h>",
      "//入力系",
      "#define cinll(...) ll __VA_ARGS__; input(__VA_ARGS__);",
      "#define cinint(...) int __VA_ARGS__; input(__VA_ARGS__);",
      "#define cinstr(...) string __VA_ARGS__; input(__VA_ARGS__);",
      "#define cinchar(...) char __VA_ARGS__; input(__VA_ARGS__);",
      "#define cinvll(a,n) vll a(n); rep(i,n) cin>>a[i];",
      "#define cinvs(a,n) vs a(n); rep(i,n) cin>>a[i];",
      "//繰り返し系",
      "#define rep1(n) for(int i=0;i<n;i++)",
      "#define rep2(i,n) for(int i=0;i<n;i++)",
      "#define rep3(i,a,n) for(int i=a;i<n;i++)",
      "#define rep4(i,a,n,b) for(int i=a;i<n;i+=b)",
      "#define overload4(a,b,c,d,e,...) e",
      "#define rep(...) overload4(__VA_ARGS__,rep4,rep3,rep2,rep1)(__VA_ARGS__)",
      "#define mrep1(n) for(int i=n;i>=0;i--)",
      "#define mrep2(i,n) for(int i=n;i>=0;i--)",
      "#define mrep3(i,n,a) for(int i=n;i>=a;i--)",
      "#define mrep4(i,n,a,b) for(int i=n;i>=a;i-=b)",
      "#define mrep(...) overload4(__VA_ARGS__,mrep4,mrep3,mrep2,mrep1)(__VA_ARGS__)",
      "//iterator系",
      "#define all(a) a.begin(),a.end()",
      "using namespace std;",
      "//型系",
      "using ll = long long;",
      "using vll = vector<long long>;",
      "using vvll = vector<vector<long long>>;",
      "using vi = vector<int>;",
      "using vvi = vector<vector<int>>;",
      "using vb = vector<bool>;",
      "using vvb = vector<vector<bool>>;",
      "using vc = vector<char>;",
      "using vvc = vector<vector<char>>;",
      "using vs = vector<string>;",
      "using pll = pair<long long,long long>;",
      "using vpll = vector<pair<long long,long long>>;",
      "",
      "//gcdを求める",
      "ll gcd(ll a,ll b){",
      "    if(a<b) return gcd(b,a);",
      "    ll r;",
      "    while((r=a%b)){",
      "        a = b;",
      "        b = r;",
      "    }",
      "    return b;",
      "}",
      "",
      "//複数個のgcdを求める",
      "ll gcds(vll a){",
      "    std::function<ll(ll,ll)> subGcd = [&](ll a, ll b){",
      "        ll mi = min(a,b);",
      "        ll ma = max(a,b);",
      "        a = ma;",
      "        b = mi;",
      "        ll r;",
      "        while(r=a%b){",
      "            a = b;",
      "            b = r;",
      "        }",
      "        return b;",
      "    };",
      "    ll ret = a[0];",
      "    rep(i,a.size()){",
      "        ret = subGcd(ret,a[i]);",
      "    }",
      "    return ret;",
      "}",
      "",
      "//gcd(a,b)*aが出るからオーバーフローに注意",
      "ll lcm(ll a,ll b){",
      "    std::function<ll(ll,ll)> subGcd = [&](ll a, ll b){",
      "        ll mi = min(a,b);",
      "        ll ma = max(a,b);",
      "        a = ma;",
      "        b = mi;",
      "        ll r;",
      "        while(r=a%b){",
      "            a = b;",
      "            b = r;",
      "        }",
      "        return b;",
      "    };",
      "    return a / subGcd(a,b) * b;",
      "}",
      "",
      "ll lcms(vll v){",
      "    std::function<ll(ll,ll)> subGcd = [&](ll a, ll b){",
      "        ll mi = min(a,b);",
      "        ll ma = max(a,b);",
      "        a = ma;",
      "        b = mi;",
      "        ll r;",
      "        while(r=a%b){",
      "            a = b;",
      "            b = r;",
      "        }",
      "        return b;",
      "    };",
      "    std::function<ll(ll,ll)> subLcm = [&](ll a, ll b){",
      "        return a / subGcd(a,b) * b;",
      "    };",
      "    ll ret = v[0];",
      "    rep(i,v.size()){",
      "        ret = subLcm(ret,v[i]);",
      "    }",
      "    return ret;",
      "}"
    ],
    "description": "入力系"
  },
  "intersection_v": {
    "prefix": "sni_intersection_v",
    "body": [
      "//複数の長方形・長方体の共通部分の面積を出す",
      "//デフォルトは値渡しになってるから注意！！！！！！！！！",
      "//vs = pll{{1,2,3},{4,5,6}},...のように、左下、右上のN次元の座標が並んでいる",
      "//一つだけ渡せばその一つの面積をだしてくれる",
      "//ここが参考になるhttps://atcoder.jp/contests/abc343/tasks/abc343_e",
      "struct Pos {",
      "    ll x,y,z;",
      "};",
      "ll intersection_v(vector<pair<Pos,Pos>> vs){",
      "    //でかい方の最小を取る",
      "    Pos mins = vs[0].snd;",
      "    rep(i,1,vs.size()){",
      "        chmin(mins.x, vs[i].snd.x);",
      "        chmin(mins.y, vs[i].snd.y);",
      "        chmin(mins.z, vs[i].snd.z);",
      "    }",
      "    //小さい方の最大を取る",
      "    Pos maxs = vs[0].fst;",
      "    rep(i,1,vs.size()){",
      "        chmax(maxs.x, vs[i].fst.x);",
      "        chmax(maxs.y, vs[i].fst.y);",
      "        chmax(maxs.z, vs[i].fst.z);",
      "    }",
      "    ll intersectionX = max(0LL, (mins.x-maxs.x));",
      "    ll intersectionY = max(0LL, (mins.y-maxs.y));",
      "    ll intersectionZ = max(0LL, (mins.z-maxs.z));",
      "    return intersectionX * intersectionY * intersectionZ;",
      "}"
    ],
    "description": "複数の長方形・長方体の共通部分の面積を出す"
  },
