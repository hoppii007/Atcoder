            "    vll ret;",
            "    for(ll i=1;i*i<=n;i++) if(n%i == 0){",
            "        ret.push_back(i);",
            "        if(i*i != n) ret.push_back(n/i);",
            "    }",
            "    sort(all(ret));",
            "    return ret;",
            "}",
