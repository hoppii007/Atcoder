      "vll enumerate_palindromes(ll n){",
      "    set<ll> se;",
      "    string s = to_string(n);",
      "    function<ll(ll,ll)> sub_pow = [&](ll a, ll b){",
      "        if(b == 0) return 1LL;",
      "        if(b == 1) return a;",
      "        if(b%2 == 0) return sub_pow(a*a,b/2);",
