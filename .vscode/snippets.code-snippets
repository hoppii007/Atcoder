  },
  "treeDepth": {
    "prefix": "sni_treeDepth",
    "body": [
      "//木の中で、rootからの距離を入れる",
      "//O(N)",
      "vll treeDepth(ll root, vvll &nexts){",
      "    vll ret(nexts.size(), inf);",
      "    std::function<void(ll,ll)> subDfs = [&](ll now, ll d){",
      "        ret[now] = d;",
      "        for(ll next: nexts[now]) if(ret[next] == inf) subDfs(next, d+1);",
      "    };",
      "    subDfs(root, 0);",
      "    return ret;",
      "}"
    ]
  },
  "treeParents": {
    "prefix": "sni_treeParents",
    "body": [
      "//木の中で、rootを指定して、各頂点のparentsを設定する",
      "//親の親は自分自身にしておく",
      "//O(N)",
      "vll treeParents(ll root, vvll &nexts){",
      "    vll ret(nexts.size(), inf);",
      "    std::function<void(ll,ll)> subDfs = [&](ll now, ll parent){",
      "        ret[now] = parent;",
      "        for(ll next: nexts[now]) if(ret[next] == inf) subDfs(next, now);",
      "    };",
      "    //親の親を-1にしたりしたいときはここの第二引数を変更",
      "    //infにするときは注意",
      "    subDfs(root, -1);",
      "    return ret;",
      "}"
    ]
  },
  "treeLongestDistanceFromRoot": {
    "prefix": "sni_treeLongestDistanceFromRoot",
    "body": [
      "//木に対して、頂点から最も遠い点（複数ある場合はどれか一つ）の{距離、番号}を返す",
      "//treeLongestDistanceFromRoot(nexts, s)のように使う",
      "pll treeLongestDistanceFromRoot(vvll &nexts, ll now, ll prev=-1){",
      "    ll ret = 0;",
      "    ll reti = now;",
      "    for(ll next: nexts[now]) if(next != prev){",
      "        pll nl = treeLongestDistanceFromRoot(nexts, next, now);",
      "        if(nl.first+1 >= ret){",
      "            ret = nl.first+1;",
      "            reti = nl.second;",
      "        }",
      "    }",
      "    return {ret, reti};",
      "}"
    ]
  },
  "lcatree": {
    "prefix": "sni_lcatree",
    "body": [
      "//一回の行き先が決まってる状態から、K回先を計算する O(N log K)",
      "//要素数:n",
      "//各状態(0 ~ n)から、2^60回までの遷移先を求める(10^18ちょいくらい)",
      "// dub[i][j] := iから2^j回遷移した先",
      "//一回の行き先をnextsに入れとく",
      "//行き先がないやつは-1",
      "vvll dubling(vll &nexts){",
      "    vvll dub(nexts.size(), vll(61));",
      "    rep(i,nexts.size()) dub[i][0] = nexts[i];",
      "    rep(j,1,61) rep(i,nexts.size()){",
      "        if(dub[i][j-1] == -1) dub[i][j] = -1;",
      "        else dub[i][j] = dub[dub[i][j-1]][j-1];",
      "    }",
      "    return dub;",
      "}",
      "",
      "//木の中で、rootからの距離を入れる",
      "//O(N)",
      "vll treeDepth(ll root, vvll &nexts){",
      "    vll ret(nexts.size(), inf);",
      "    std::function<void(ll,ll)> subDfs = [&](ll now, ll d){",
      "        ret[now] = d;",
      "        for(ll next: nexts[now]) if(ret[next] == inf) subDfs(next, d+1);",
      "    };",
      "    subDfs(root, 0);",
      "    return ret;",
      "}",
      "",
      "//木の中で、rootを指定して、各頂点のparentsを設定する",
      "//親の親は自分自身にしておく",
      "//O(N)",
      "vll treeParents(ll root, vvll &nexts){",
      "    vll ret(nexts.size(), inf);",
      "    std::function<void(ll,ll)> subDfs = [&](ll now, ll parent){",
      "        ret[now] = parent;",
      "        for(ll next: nexts[now]) if(ret[next] == inf) subDfs(next, now);",
      "    };",
      "    //親の親を-1にしたりしたいときはここの第二引数を変更",
      "    //infにするときは注意",
      "    subDfs(root, -1);",
      "    return ret;",
      "}",
      "",
      "//各頂点は0 ~ N-1の番号で管理",
      "//共通祖先をO(Log V)で出すやつ",
      "//前計算はO(V Log V)",
      "//nexts : 有向グラフにしておく（親にも子にも行けるから実質無向グラフ）",
      "struct LcaTree {",
      "public:",
      "    //親",
      "    ll root;",
      "",
      "    //parents[i] : iの親を示す（親は必ず一人だからvllでいい）",
      "    //親の親は自分自身にする",
      "    vll parents;",
      "",
      "    //根からの距離を入れる",
      "    vll distToRoot;",
      "",
      "    //iから2^j回遡ったところ",
      "    vvll backDub;",
      "",
      "    LcaTree(ll r, vvll &nexts){",
      "        //parentsとrootをセット",
      "        root = r;",
      "        parents = treeParents(root, nexts);",
      "",
      "        //rootからの距離をセット",
      "        distToRoot = treeDepth(root, nexts);",
      "",
      "        //遡る用のdubling配列を用意",
      "        backDub = dubling(parents);",
      "    }",
      "",
      "    //頂点uからn回遡りたい",
      "    ll back(ll u, ll n){",
      "        ll t = 0;",
      "        while((1LL << t) <= n){",
      "            if((1LL << t) & n){",
      "                u = backDub[u][t];",
      "                if(u == -1) return root;",
      "            }",
      "            t++;",
      "        }",
      "        return u;",
      "    }",
      "",
      "    ll lca(ll u, ll v){",
      "        //高さを揃える",
      "        if(distToRoot[u] < distToRoot[v]) v = back(v, distToRoot[v]-distToRoot[u]);",
      "        else if(distToRoot[u] > distToRoot[v]) u = back(u, distToRoot[u]-distToRoot[v]);",
      "",
      "        if(u == v) return u;",
      "",
      "        //今のu,vからx遡ったら同じになる、最小のxを求める",
      "        //dublingっぽくやる(2^i進んでも違うなら進む、をiが大きい順に繰り返す)",
      "        mrep(i,60) if(backDub[u][i] != backDub[v][i]) {",
      "            u = backDub[u][i];",
      "            v = backDub[v][i];",
      "        }",
      "        return parents[u];",
      "",
      "        //にぶんたんでやる方法もある",
      "    }",
      "",
      "    //2点間の距離",
      "    ll dist(ll u, ll v){",
      "        ll l = this->lca(u,v);",
      "        return distToRoot[u] + distToRoot[v] - 2*distToRoot[l];",
      "    }",
      "    ",
      "};"
    ]
  },
  "scc": {
    "prefix": "sni_scc",
    "body": [
      "//強連結成分ごとにid（0から）を振った配列を返す",
      "//sからの連結成分については全て処理できる",
      "vll scc(vvll &nexts){",
      "    //最終的にsccIDを格納するやつ",
      "    vll sccIds(nexts.size(),-1);",
      "",
      "    //逆辺のグラフを作成",
      "    vvll invNexts(nexts.size());",
      "    rep(i,nexts.size()){",
      "        for(ll next: nexts[i]){",
      "            invNexts[next].push_back(i);",
      "        }",
      "    }",
      "",
      "    //帰りがけ順で記録していくやつ",
      "    ll order = 0;",
      "    ll sccId = 0;",
      "    ",
      "    vll orders(nexts.size());",
      "    vb visitIki(nexts.size(), false);",
      "    std::function<void(ll)> scc1 = [&](ll now){",
      "        visitIki[now] = true;",
      "        for(ll next: nexts[now]){",
      "            if(visitIki[next]) continue;",
      "            scc1(next);",
      "        }",
      "        ",
      "        orders[now] = order++;",
      "    };",
      "    std::function<void(ll)> scc2 = [&](ll now){",
      "        sccIds[now] = sccId;",
      "        for(ll next: invNexts[now]){",
      "            if(sccIds[next] != -1) continue;",
      "            scc2(next);",
      "        }",
      "    };",
      "    //全部の頂点について、そこから行けるところのorderを全部記録する",
      "    rep(i, nexts.size()) if(visitIki[i] == false) scc1(i);",
      "",
      "    //{帰りがけのOrder、index}のペアを降順にソート",
      "    vpll orderIds(nexts.size());",
      "    rep(i,nexts.size()) orderIds[i] = {orders[i], i};",
      "    sort(all(orderIds));",
      "    reverse(all(orderIds));",
      "",
      "    rep(i,nexts.size()) if(sccIds[orderIds[i].second] == -1){",
      "        scc2(orderIds[i].second);",
      "        sccId++;",
      "    } ",
      "    return sccIds;",
      "}"
    ]
  },
  "kruskal": {
    "prefix": "sni_kruskal",
    "body": [
      "struct UnionFind {",
      "public:",
      "    vll par; // par[i]:iの親の番号　(例) par[3] = 2 : 3の親が2",
      "    vll kosu;",
      "    ll Count; //全体として何個の集合があるか",
      "    ",
      "    UnionFind(ll n) : par(n),kosu(n),Count(n) { //最初は全てが根であるとして初期化",
      "        rep(i,n){",
      "            par[i] = i;",
      "            kosu[i] = 1;",
      "        }",
      "    }",
      "",
      "    ll root(ll x) { // データxが属する木の根を再帰で得る：root(x) = {xの木の根}",
      "        if (par[x] == x) return x;",
      "        return par[x] = root(par[x]);",
      "    }",
      "",
      "    void unite(ll x, ll y) { // xとyの木を併合",
      "        ll rx = root(x); //xの根をrx",
      "        ll ry = root(y); //yの根をry",
      "        if (rx == ry) return; //xとyの根が同じ(=同じ木にある)時はそのまま",
      "        par[rx] = ry; //xとyの根",
      "        kosu[ry] += kosu[rx];",
      "        Count--;",
      "    }",
      "",
      "    bool same(ll x, ll y) { // 2つのデータx, yが属する木が同じならtrueを返す",
      "        ll rx = root(x);",
      "        ll ry = root(y);",
      "        return rx == ry;",
      "    }",
      "    ",
      "    ll size(ll x){",
      "        return kosu[root(x)];",
      "    }",
      "    ll size(){",
      "        return Count;",
      "    }",
      "};",
      "",
      "//0 ~ N-1までのグラフ（連結）の中で、最小全域木を作る",
      "// O(E log E)",
      "//無向グラフだったとしても有向グラフとして作るから、同じu,vを結ぶ編は一つしか出てこない",
      "//costの型$1（基本的にはllかdouble）",
      "//nextsは{cost,index}",
      "//実際の最小コストだけが欲しいときは、戻り値の型をllにして、minCostを返せばいい",
      "vector<vector<pair<$1,ll>>> kruskal(vector<vector<pair<$1,ll>>> &nexts){",
      "    UnionFind uf(nexts.size());",
      "    struct KruskalEdge{",
      "        ll u,v;",
      "        $1 c;",
      "    };",
      "    vector<KruskalEdge> edges;",
      "    rep(i, nexts.size()) for(pair<$1,ll> e: nexts[i]){",
      "        edges.push_back({i, e.second, e.first});",
      "    }",
      "    //trueだったら第1引数が手前に来る",
      "    //p1 < p2として作ると昇順になる",
      "    //p2 < p1として作ると降順になる",
      "    ",
      "    //sort(all(v), compf);みたいに使ってね",
      "    std::function<bool(KruskalEdge&, KruskalEdge&)> compf = [&](const KruskalEdge &p1,const KruskalEdge &p2) {",
      "        return p1.c < p2.c;",
      "    };",
      "    ",
      "    sort(all(edges), compf);",
      "    $1 minCost = 0;",
      "    vector<vector<pair<$1,ll>>> ret(nexts.size());",
      "    rep(i,edges.size()){",
      "        if(!uf.same(edges[i].u, edges[i].v)){",
      "            uf.unite(edges[i].u, edges[i].v);",
      "            minCost += edges[i].c;",
      "            ret[edges[i].u].push_back({edges[i].c, edges[i].v});",
      "        }",
      "    }",
      "    //最小コストだけがほしいならここでminCostを返す",
      "    return ret;",
      "}"
    ]
  },
  "trietree": {
    "prefix": "sni_trietree",
    "body": [
      "//文字列の検索がmax(s_i.size())で可能",
      "//共通接頭辞の数を数えたりできる",
      "class TrieTree{",
      "public:",
      "    ////////////////////////////////",
      "    // 大文字小文字とかの区別はここ //",
      "    ////////////////////////////////",
      "    //mutable型じゃないやつ（stringとか）をconstで初期化しようと思ったらinlineがいるらしい",
      "    static inline const string char_set = \"abcdefghijklmnopqrstuvwxyz\";",
      "    //static inline const string char_set = \"ABCDEFGHIJKLMNOPQRSTUVWXYZ\";",
      "",
      "    //根っこの文字IDは-1にしとく（そのほかはchar_setのindex）",
      "    static const ll root = -1;",
      "",
      "    //Trie木の各頂点",
      "    class Node {",
      "    public:",
      "        vll nextIdx = vll(char_set.size(), -1);      //nextIdx[i] := idがiの文字に行くときのNodeのインデックス（存在しない場合は-1）",
      "        ll charId = -1;           //今のnodeにある文字ID（'a'なら0みたいな）",
      "        ll wordCountFuture = 0;   //この下にいくつ単語があるか(自分も含む)",
      "        ll wordCount = 0;    //ここで止まる単語がいくつあるか",
      "",
      "        Node(ll c){ charId = c; }",
      "        Node(){}",
      "    };",
      "    ",
      "    ",
      "    vector<Node> nodes;     // 頂点集合",
      "    map<char,ll> charToId;  // 各文字をIDに変換する",
      "",
      "    //rootの追加と、charToIdの設定",
      "    TrieTree(){",
      "        nodes.push_back(Node(root));",
      "        rep(i,char_set.size()) charToId[char_set[i]] = i;",
      "    }",
      "    ",
      "    //単語の追加",
      "    void insert(const string &word){",
      "        //rootは必ず0番目になる",
      "        ll index = 0;",
      "",
      "        //rootについてもFutureをカウントしとく（全体でのsizeを出すため）",
      "        nodes[index].wordCountFuture++;",
      "",
      "        rep(i,word.size()){",
      "            ll cid = charToId[word[i]];",
      "            //今のindexから文字cidに行くパスがなければ追加する",
      "            if(nodes[index].nextIdx[cid] == -1){",
      "                nodes[index].nextIdx[cid] = nodes.size();",
      "                index = nodes.size();",
      "                nodes.push_back(Node(cid));",
      "            }",
      "            //cidに行ければ行く",
      "            else{",
      "                index = nodes[index].nextIdx[cid];",
      "            }",
      "            //ここを通ったということは、この先にあるということ",
      "            nodes[index].wordCountFuture++;",
      "        }",
      "        nodes[index].wordCount++;",
      "    }",
      "",
      "    //全部で単語がいくつあるか？",
      "    ll size(){",
      "        return nodes[0].wordCountFuture;",
      "    }",
      "",
      "    //この単語がいくつあるか？",
      "    ll countWord(const string &word){",
      "        ll index = 0;",
      "        rep(i,word.size()){",
      "            ll cid = charToId[word[i]];",
      "            if(nodes[index].nextIdx[cid] == -1) return 0;",
      "            index = nodes[index].nextIdx[cid];",
      "        }",
      "        return nodes[index].wordCount;",
      "    }",
      "",
      "    //これをprefixにもつ単語がいくつあるか？（自分含めて）",
      "    ll countWordFuture(const string &word, bool includeMe=true){",
      "        ll index = 0;",
      "        rep(i,word.size()){",
      "            ll cid = charToId[word[i]];",
      "            if(nodes[index].nextIdx[cid] == -1) return 0;",
      "            index = nodes[index].nextIdx[cid];",
      "        }",
      "        if(includeMe) return nodes[index].wordCountFuture;",
      "        else return nodes[index].wordCountFuture - nodes[index].wordCount;",
      "    }",
      "",
      "    //この文字列の接頭辞がいくつあるか？（自分含め）",
      "    //atcoderに対してatやatcなどがいくつあるか？（デフォルトは重複も数える）",
      "    ll countPrefix(const string &word, bool isCountDuplication=true) {",
      "        ll index = 0;",
      "        ll ret = 0;",
      "        rep(i,word.size()){",
      "            ll cid = charToId[word[i]];",
      "            if(nodes[index].nextIdx[cid] == -1) return ret;",
      "            index = nodes[index].nextIdx[cid];",
      "            if(isCountDuplication) ret += nodes[index].wordCount;",
      "            else ret += (nodes[index].wordCount>0?1:0);",
      "        }",
      "        return ret;",
      "    }",
      "};"
    ]
  },
  "rerootingtreedp": {
    "prefix": "sni_rerooting_treedp",
    "body": [
      "//全方位木DP",
      "//各頂点からのDFSで解ける問題がO(N)で解ける",
      "",
      "//条件",
      "//木DPを普通にやった後、頂点を「ずらす」操作がある程度高速（O(|childs|）程度）でできればOK",
      "//左右から半壊区間を伸ばして、それの結合とかでできれば嬉しいね",
      "",
      "//関数",
      "template <typename T>",
      "struct RerootingTreeDP{",
      "public:",
      "    //集計結果と自分の値から、自分が持つべき値を計算する",
      "    //引数 : 自分の値、集計結果",
      "",
      "    ll n;",
      "    ",
      "    //edgedp用マップ",
      "    vector<vector<T>> dp;",
      "    ",
      "    //頂点DP用マップ",
      "    vector<T> rootDP;",
      "",
      "    //edges",
      "    vvll nexts;",
      "    vector<T> values;",
      "    // edge_idx[i][j] := iから、jに伸びている辺は、nexts[j]の何番目か",
      "    vector<unordered_map<ll,ll>> edge_idx;",
      "",
      "    T (*marge_child)(T,T);",
      "    T (*aggrigate)(T,T);",
      "    T e;",
      "",
      "    RerootingTreeDP(const vvll& _nexts, const vector<T>& _values, T (*_aggrigate)(T,T), T(*_marge_child)(T,T), T _e): nexts(_nexts), values(_values), aggrigate(_aggrigate), marge_child(_marge_child), e(_e){",
      "        n = nexts.size();",
      "",
      "        edge_idx.resize(n);",
      "        rep(i, n) rep(j, nexts[i].size()) edge_idx[i][nexts[i][j]] = j;",
      "",
      "        rootDP.resize(n);",
      "",
      "        dp.resize(n);",
      "        //最初にDP配列を初期化",
      "        rep(i,n) dp[i].resize(nexts[i].size(), e);",
      "        ",
      "        //0番目を根として最初のdfsをやる",
      "        rep(i, nexts[0].size()) setNodeDfs(0, i);",
      "        ",
      "        //今の根っこからBFSしながら逆辺のdpを求めていく",
      "        // rootDPの設定もやっちゃう",
      "        rerootingBfs();",
      "    }",
      "    RerootingTreeDP(){}",
      "",
      "    //もらった辺の先っちょ以降の部分技について値を求める",
      "    //最初に呼ぶだけ",
      "    //普通に木DPすればOK",
      "    //アドホックに作ってね",
      "    //dp[parent][now]の初期化を忘れずに",
      "    void setNodeDfs(ll parent, ll i){",
      "        ll now = nexts[parent][i];",
      "        T childs_value = e;",
      "        rep(ni,  nexts[now].size()){",
      "            if(nexts[now][ni] == parent) continue;",
      "            setNodeDfs(now, ni);",
      "            childs_value = marge_child(childs_value, dp[now][ni]);",
      "        }",
      "        dp[parent][i] = aggrigate(values[now], childs_value);",
      "        return;",
      "    }",
      "    ",
      "    // 根っこからBFSで逆辺のDPを求めていく",
      "    // rootDPの設定もやっちゃう",
      "    void rerootingBfs(){",
      "        ",
      "        queue<ll> q;",
      "        q.push(0);",
      "        ",
      "        vb visit(nexts.size());",
      "        visit[0] = true;",
      "        ",
      "        while(q.empty() == false){",
      "            //dp[{now,*}]がすでに求まっている",
      "            //その状態で、dp[{*,now}]を求めていく",
      "            ",
      "            ll now = q.front();",
      "            q.pop();",
      "            ",
      "            //margeR[i] := i番目より後の子供の値を連結した値",
      "            vector<T> margeR(nexts[now].size(), e);",
      "            mrep(i, (ll)nexts[now].size()-2) margeR[i] = marge_child(margeR[i+1], dp[now][i+1]);",
      "            ",
      "            T left = e;",
      "            ",
      "            //左右からの累積和を使ってi番目の子供への辺を逆転したdpを求める",
      "            rep(i, nexts[now].size()){",
      "                ll next = nexts[now][i];",
      "                dp[next][edge_idx[next][now]] = aggrigate(values[now], marge_child(left, margeR[i]));",
      "                left = marge_child(left, dp[now][i]);",
      "                //行った先始点verをまだ計算してなければ計算する",
      "                if(visit[next] == false){",
      "                    q.push(next);",
      "                    visit[next] = true;",
      "                }",
      "            }",
      "",
      "            rootDP[now] = aggrigate(values[now], left);",
      "        }",
      "        ",
      "    }",
      "",
      "};"
    ]
  },
  "eulertour": {
    "prefix": "sni_eulertour",
    "body": [
      "//頂点番号 -> {行きがけ距離,帰りがけ+1}を記録する",
      "//自分を含む部分木集合が[fst,snd)になる",
      "//木であることは必要",
      "vpll euler_tour(vvll &nexts, ll root){",
      "    vpll ret(nexts.size(), {-1,-1});",
      "    ll order = 0;",
      "    std::function<void(ll)> dfs = [&](ll now){",
      "        ret[now].fst = order++;",
      "        for(ll next: nexts[now]) if(ret[next].fst == -1){",
      "            dfs(next);",
      "        }",
      "        ret[now].snd = order;",
      "    };",
      "    dfs(root);",
      "    return ret;",
      "}"
    ]
  },
  "treediameter": {
    "prefix": "sni_treeDiameter",
    "body": [
      "//木に対して、頂点から最も遠い点（複数ある場合はどれか一つ）の{距離、番号}を返す",
      "//treeLongestDistanceFromRoot(nexts, s)のように使う",
      "pll treeLongestDistanceFromRoot(vvll &nexts, ll now, ll prev=-1){",
      "    ll ret = 0;",
      "    ll reti = now;",
      "    for(ll next: nexts[now]) if(next != prev){",
      "        pll nl = treeLongestDistanceFromRoot(nexts, next, now);",
      "        if(nl.first+1 >= ret){",
      "            ret = nl.first+1;",
      "            reti = nl.second;",
      "        }",
      "    }",
      "    return {ret, reti};",
      "}",
