    "prefix": "sni_binary_search",
    "body": [
      "//二分探索のジャッジ用のやつ",
      "auto nibutan_judge = [&](ll mid){",
      "    return true;",
      "};",
      "ll ok = inf;",
      "ll ng = 0;",
      "while(abs(ok-ng) > 1){",
