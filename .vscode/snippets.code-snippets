    "unionfind": {
        "prefix": "sni_unionfind",
        "body": [
            "struct UnionFind {",
            "public:",
            "    vll par; // par[i]:iの親の番号　(例) par[3] = 2 : 3の親が2",
            "    vll kosu;",
            "    ll Count; //全体として何個の集合があるか",
            "    ",
            "    UnionFind(ll n) : par(n),kosu(n),Count(n) { //最初は全てが根であるとして初期化",
            "        rep(i,n){",
            "            par[i] = i;",
            "            kosu[i] = 1;",
            "        }",
            "    }",
            "",
            "    ll root(ll x) { // データxが属する木の根を再帰で得る：root(x) = {xの木の根}",
            "        if (par[x] == x) return x;",
            "        return par[x] = root(par[x]);",
            "    }",
            "",
            "    void unite(ll x, ll y) { // xとyの木を併合",
            "        ll rx = root(x); //xの根をrx",
            "        ll ry = root(y); //yの根をry",
            "        if (rx == ry) return; //xとyの根が同じ(=同じ木にある)時はそのまま",
            "        par[rx] = ry; //xとyの根",
            "        kosu[ry] += kosu[rx];",
            "        Count--;",
            "    }",
            "",
            "    bool same(ll x, ll y) { // 2つのデータx, yが属する木が同じならtrueを返す",
            "        ll rx = root(x);",
            "        ll ry = root(y);",
            "        return rx == ry;",
            "    }",
            "    ",
            "    ll size(ll x){",
            "        return kosu[root(x)];",
            "    }",
            "    ll size(){",
            "        return Count;",
            "    }",
            "};",
        ]
    },
    "segtree": {
        "prefix": "sni_segtree",
        "body":[
            "//コンストラクタ　関数ポインタの部分は普通に関数名書くだけでOK",
            "//SegmentTree<T>(vector<T>&,T (*f)(T,T),T ide)",
            "//SegmentTree<T>(int n,T (*f)(T,T),T ide)",
            "//関数",
            "//Change(int,T)",
            "//get(int,int)閉区間",
            "template<typename T>",
            "class SegmentTree{",
            "    int n;",
            "    T ident;",
            "    vector<T> array;",
            "    T (*op)(T,T);",
            "public:",
            "    SegmentTree(vector<T> &v,T (*f)(T,T),T ide){",
            "        int sz = v.size();",
            "        this->n = 1;",
            "        while(n < sz) n *= 2;",
            "        this->array = vector<T>(2*this->n-1,ide);",
            "        this->ident = ide;",
            "        this->op = f;",
            "        for(int i=0;i<sz;i++) change(i,v[i]);",
            "    }",
            "    SegmentTree(int a,T (*f)(T,T),T ide){",
            "        this->n = 1;",
            "        while(n < a) n*= 2;",
            "        this->array = vector<T>(2*this->n-1,ide);",
            "        this->ident = ide;",
            "        this->op = f;",
            "    }",
            "    SegmentTree(){}",
            "    int l_child(int i){ return i*2+1; }",
            "    int r_child(int i){ return i*2+2; }",
            "    int get_parent(int i){ return (i%2 == 0) ? (i/2-1):(i/2); }",
            "    void change(int i,T v){",
            "        int ind = this->array.size()/2+i;",
            "        this->array[ind] = v;",
            "        int parent = get_parent(ind);",
            "        while(parent != -1){",
            "            this->array[parent] = op(this->array[l_child(parent)],this->array[r_child(parent)]);",
            "            parent = get_parent(parent); ",
            "        }",
            "    }",
            "    T get(int l,int r,int k=0,int nowL=-1,int nowR=-1){",
            "        if(k == 0){",
            "            nowL = 0;",
            "            nowR = this->array.size()/2;",
            "        }",
            "        if(r < nowL || nowR < l) return this->ident;",
            "        if(l <= nowL && nowR <= r) return this->array[k];",
            "        T vl = get(l,r,l_child(k),nowL,(nowL+nowR)/2);",
            "        T vr = get(l,r,r_child(k),(nowL+nowR)/2+1,nowR);",
            "        return op(vl,vr);",
            "    }",
            "};",
            "",
        ]
    },
    "lazy_segtree": {
        "prefix": "sni_lazy_segtree",
        "body":[
            "//区間更新、区間クエリはこいつにおまかせ！",
            "///////注意/////////",
            "//・T,opT,idTがモノイドになっている",
            "//・O,opO,idOがモノイドになっている",
            "//・f(o,(opT(t1,t2))) = opT(f(o,t1),f(o,t2))",
            "//・f(opO(o1,o2),t) = f(o1,f(op2,t))",
            "//・f(idO,t) = t",
            "////////////////////",
            "//コンストラクタ　関数ポインタの部分は普通に関数名書くだけでOK",
            "//LazySegmentTree<T,O>(T配列、T演算、T単位元、O演算、O単位元、更新作用(OxT -> T))",
            "//LazySegmentTree<T,O>(T配列の数、T演算、T単位元、O演算、O単位元、更新作用(OxT -> T))",
            "//関数",
            "//change(int,int,O) : 閉区間を作用素oで更新",
            "//get(int,int)閉区間",
            "template<typename T,typename O>",
            "class LazySegmentTree{",
            "public:",
            "    //要素のモノイド",
            "    T idT;",
            "    T (*opT)(T,T);",
            "    vector<T> arrayT;",
            "    //作用素のモノイド（この値について作用が一つ求まる）",
            "    O idO;",
            "    O (*opO)(O,O);",
            "    vector<O> arrayO;",
            "    //作用素から作用を作り、それをtに適用する",
            "    T (*f)(O,T);",
            "    ",
            "public:",
            "    int l_child(int i){ return i*2+1; }",
            "    int r_child(int i){ return i*2+2; }",
            "    int get_parent(int i){ return (i%2 == 0) ? (i/2-1):(i/2); }",
            "    LazySegmentTree(vector<T> &v, T (*opt)(T,T),T idt, O (*opo)(O,O), O ido, T (*tf)(O,T)){",
            "        int sz = v.size();",
            "        int n = 1;",
            "        while(n < sz) n *= 2;",
            "        this->idT = idt;",
            "        this->opT = opt;",
            "        this->idO = ido;",
            "        this->opO = opo;",
            "        this->arrayT = vector<T>(2*n-1,this->idT);",
            "        this->arrayO = vector<O>(2*n-1,this->idO);",
            "        this->f = tf;",
            "        for(int i=0;i<sz;i++) this->arrayT[this->arrayT.size()/2+i] = v[i];",
            "        for(int i=this->arrayT.size()/2-1;i>=0;i--){",
            "            this->arrayT[i] = opT(this->arrayT[l_child(i)],this->arrayT[r_child(i)]);",
            "        }",
            "    }",
            "    LazySegmentTree(int a, T (*opt)(T,T),T idt, O (*opo)(O,O), O ido, T (*tf)(O,T)){",
            "        int n = 1;",
            "        while(n < a) n*= 2;",
            "        this->idT = idt;",
            "        this->opT = opt;",
            "        this->idO = ido;",
            "        this->opO = opo;",
            "        this->arrayT = vector<T>(2*n-1,this->idT);",
            "        this->arrayO = vector<O>(2*n-1,this->idO);",
            "        this->f = tf;",
            "    }",
            "    LazySegmentTree(){}",
            "    void o_update(int k,O o){",
            "        this->arrayT[k] = f(o,this->arrayT[k]);",
            "        this->arrayO[k] = opO(o,this->arrayO[k]);",
            "        //葉なら更新履歴をリセットする",
            "        if(l_child(k) >= this->arrayT.size()) this->arrayO[k] = idO;",
            "    }",
            "    //[l,r] : 更新したい閉区間",
            "    //o : 更新に使いたい作用素（[l,r]のすべてのtをf(o,t)にしたい）",
            "    //k : 自分のインデックス",
            "    //[nowL,nowR] : 自分がカバーしている閉区間",
            "    void change(int l,int r,O o,int k=0,int nowL=-1,int nowR=-1){",
            "        //親は最初から最後までカバー",
            "        if(k == 0){",
            "            nowL = 0;",
            "            nowR = this->arrayT.size()/2;",
            "        }",
            "        //自分のカバー範囲と変更範囲が全く変わらないときは何もしない",
            "        if(r < nowL || nowR < l){ return; }",
            "        //自分のカバー範囲内全部を更新するとき",
            "        if(l <= nowL && nowR <= r){",
            "            //完全にかぶる場合、値と変更履歴を更新しておく",
            "            o_update(k,o);",
            "            return;",
            "        }",
            "        //自分の中のカバー範囲の1部が被ってるとき",
            "        //自分の更新履歴を下に引き継ぐ",
            "        int lc = l_child(k);",
            "        int rc = r_child(k);",
            "        //葉じゃないときは今溜まってる更新履歴を下に伝播",
            "        if(lc < this->arrayT.size()){",
            "            o_update(lc,this->arrayO[k]);",
            "            o_update(rc,this->arrayO[k]);",
            "            this->arrayO[k] = idO;",
            "        }",
            "        change(l,r,o,lc,nowL,(nowL+nowR)/2);",
            "        change(l,r,o,rc,(nowL+nowR)/2+1,nowR);",
            "        //自分の値を更新",
            "        this->arrayT[k] = opT(arrayT[lc],arrayT[rc]);",
            "        return;",
            "    }",
            "    //o : 親までの更新履歴",
            "    T get(int l,int r,int k=0,int nowL=-1,int nowR=-1){",
            "        //親は最初から最後までカバー",
            "        if(k == 0){",
            "            nowL = 0;",
            "            nowR = this->arrayT.size()/2;",
            "        }",
            "        //カバー範囲が全く被らないときは単位元を返す",
            "        if(r < nowL || nowR < l) return this->idT;",
            "        //完全にかぶっているとき（葉の時は必ずここに来る）",
            "        if(l <= nowL && nowR <= r){",
            "            //葉なら更新は終わってるはずだから返すだけ",
            "            if(l_child(k) >= this->arrayT.size()){",
            "                return this->arrayT[k];",
            "            }",
            "            //葉じゃなくても更新が終わってるなら返す",
            "            if(this->arrayO[k] == idO){",
            "                return this->arrayT[k];",
            "            }",
            "            //葉じゃなくて更新も終わってないなら更新して一個下にだけ流して返す",
            "            o_update(l_child(k),this->arrayO[k]);",
            "            o_update(r_child(k),this->arrayO[k]);",
            "            this->arrayO[k] = idO;",
            "            return this->arrayT[k];",
            "        }",
            "        //更新履歴を下に流す",
            "        int lc = l_child(k);",
            "        int rc = r_child(k);",
            "        //葉じゃないときは更新履歴を下に伝播",
            "        if(lc < this->arrayT.size()){",
            "            o_update(lc,this->arrayO[k]);",
            "            o_update(rc,this->arrayO[k]);",
            "            this->arrayO[k] = idO;",
            "        }",
            "        T vl = get(l,r,lc,nowL,(nowL+nowR)/2);",
            "        T vr = get(l,r,rc,(nowL+nowR)/2+1,nowR);",
            "        this->arrayO[k] = idO;",
            "        this->arrayT[k] = opT(arrayT[lc],arrayT[rc]);",
            "        return opT(vl,vr);",
            "    }",
            "    ",
            "    void showTree(){",
            "        int n = 1;",
            "        int j=0;",
            "        while(n+j < this->arrayT.size()){",
            "            while(j < n){",
            "                cout<<\"(\"<<this->arrayT[n+j-1].first<<\",\"<<this->arrayT[n+j-1].second<<\")\"<<\"/\"<<this->arrayO[n+j-1]<<\" \";",
            "                j++;",
            "            }",
            "            cout<<endl;",
            "            n *= 2;",
            "            j = 0;",
            "        }",
            "    }",
            "};",
        ]
    },
    "treeDepth":{
        "prefix": "sni_treeDepth",
        "body": [
            "//木の中で、rootからの距離を入れる",
            "//O(N)",
            "vll treeDepth(ll root, vvll &nexts){",
            "    vll ret(nexts.size(), inf);",
            "    std::function<void(ll,ll)> subDfs = [&](ll now, ll d){",
            "        ret[now] = d;",
            "        for(ll next: nexts[now]) if(ret[next] == inf) subDfs(next, d+1);",
            "    };",
            "    subDfs(root, 0);",
            "    return ret;",
            "}",
        ]
    },
    "treeParents":{
        "prefix": "sni_treeParents",
        "body": [
            "//木の中で、rootを指定して、各頂点のparentsを設定する",
            "//親の親は自分自身にしておく",
            "//O(N)",
            "vll treeParents(ll root, vvll &nexts){",
            "    vll ret(nexts.size(), inf);",
            "    std::function<void(ll,ll)> subDfs = [&](ll now, ll parent){",
            "        ret[now] = parent;",
            "        for(ll next: nexts[now]) if(ret[next] == inf) subDfs(next, now);",
            "    };",
            "    //親の親を-1にしたりしたいときはここの第二引数を変更",
            "    //infにするときは注意",
            "    subDfs(root, -1);",
            "    return ret;",
            "}",
        ]
    },
    "treeLongestDistanceFromRoot":{
        "prefix": "sni_treeLongestDistanceFromRoot",
        "body": [
            "//木に対して、頂点から最も遠い点（複数ある場合はどれか一つ）の{距離、番号}を返す",
            "//treeLongestDistanceFromRoot(nexts, s)のように使う",
            "pll treeLongestDistanceFromRoot(vvll &nexts, ll now, ll prev=-1){",
            "    ll ret = 0;",
            "    ll reti = now;",
            "    for(ll next: nexts[now]) if(next != prev){",
            "        pll nl = treeLongestDistanceFromRoot(nexts, next, now);",
            "        if(nl.first+1 >= ret){",
            "            ret = nl.first+1;",
            "            reti = nl.second;",
            "        }",
            "    }",
            "    return {ret, reti};",
            "}",
        ]
    },
    "lca":{
        "prefix": "sni_lca",
        "body": [
            "//一回の行き先が決まってる状態から、K回先を計算する O(N log K)",
            "//要素数:n",
            "//各状態(0 ~ n)から、2^60回までの遷移先を求める(10^18ちょいくらい)",
            "// dub[i][j] := iから2^j回遷移した先",
            "//一回の行き先をnextsに入れとく",
            "//行き先がないやつは-1",
            "vvll dubling(vll &nexts){",
            "    vvll dub(nexts.size(), vll(61));",
            "    rep(i,nexts.size()) dub[i][0] = nexts[i];",
            "    rep(j,1,61) rep(i,nexts.size()){",
            "        if(dub[i][j-1] == -1) dub[i][j] = -1;",
            "        else dub[i][j] = dub[dub[i][j-1]][j-1];",
            "    }",
            "    return dub;",
            "}",
            "",
            "//木の中で、rootからの距離を入れる",
            "//O(N)",
            "vll treeDepth(ll root, vvll &nexts){",
            "    vll ret(nexts.size(), inf);",
            "    std::function<void(ll,ll)> subDfs = [&](ll now, ll d){",
            "        ret[now] = d;",
            "        for(ll next: nexts[now]) if(ret[next] == inf) subDfs(next, d+1);",
            "    };",
            "    subDfs(root, 0);",
            "    return ret;",
            "}",
            "",
            "//木の中で、rootを指定して、各頂点のparentsを設定する",
            "//親の親は自分自身にしておく",
            "//O(N)",
            "vll treeParents(ll root, vvll &nexts){",
            "    vll ret(nexts.size(), inf);",
            "    std::function<void(ll,ll)> subDfs = [&](ll now, ll parent){",
            "        ret[now] = parent;",
            "        for(ll next: nexts[now]) if(ret[next] == inf) subDfs(next, now);",
            "    };",
            "    //親の親を-1にしたりしたいときはここの第二引数を変更",
            "    //infにするときは注意",
            "    subDfs(root, -1);",
            "    return ret;",
            "}",
            "",
            "//各頂点は0 ~ N-1の番号で管理",
            "//共通祖先をO(Log V)で出すやつ",
            "//前計算はO(V Log V)",
            "//nexts : 有向グラフにしておく（親にも子にも行けるから実質無向グラフ）",
            "struct LcaTree {",
            "public:",
            "    //親",
            "    ll root;",
            "",
            "    //parents[i] : iの親を示す（親は必ず一人だからvllでいい）",
            "    //親の親は自分自身にする",
            "    vll parents;",
            "",
            "    //根からの距離を入れる",
            "    vll distToRoot;",
            "",
            "    //iから2^j回遡ったところ",
            "    vvll backDub;",
            "",
            "    LcaTree(ll r, vvll &nexts){",
            "        //parentsとrootをセット",
            "        root = r;",
            "        parents = treeParents(root, nexts);",
            "",
            "        //rootからの距離をセット",
            "        distToRoot = treeDepth(root, nexts);",
            "",
            "        //遡る用のdubling配列を用意",
            "        backDub = dubling(parents);",
            "    }",
            "",
            "    //頂点uからn回遡りたい",
            "    ll back(ll u, ll n){",
            "        ll t = 0;",
            "        while((1LL << t) <= n){",
            "            if((1LL << t) & n){",
            "                u = backDub[u][t];",
            "                if(u == -1) return root;",
            "            }",
            "            t++;",
            "        }",
            "        return u;",
            "    }",
            "",
            "    ll lca(ll u, ll v){",
            "        //高さを揃える",
            "        if(distToRoot[u] < distToRoot[v]) v = back(v, distToRoot[v]-distToRoot[u]);",
            "        else if(distToRoot[u] > distToRoot[v]) u = back(u, distToRoot[u]-distToRoot[v]);",
            "",
            "        if(u == v) return u;",
            "",
            "        //今のu,vからx遡ったら同じになる、最小のxを求める",
            "        //dublingっぽくやる(2^i進んでも違うなら進む、をiが大きい順に繰り返す)",
            "        mrep(i,60) if(backDub[u][i] != backDub[v][i]) {",
            "            u = backDub[u][i];",
            "            v = backDub[v][i];",
            "        }",
            "        return parents[u];",
            "",
            "        //にぶんたんでやる方法もある",
            "    }",
            "",
            "    //2点間の距離",
            "    ll dist(ll u, ll v){",
            "        ll l = this->lca(u,v);",
            "        return distToRoot[u] + distToRoot[v] - 2*distToRoot[l];",
            "    }",
            "    ",
            "};",
        ]
    },
    "scc":{
        "prefix": "sni_scc",
        "body": [
            "//強連結成分ごとにid（0から）を振った配列を返す",
            "//sからの連結成分については全て処理できる",
            "vll scc(vvll &nexts){",
            "    //最終的にsccIDを格納するやつ",
            "    vll sccIds(nexts.size(),-1);",
            "",
            "    //逆辺のグラフを作成",
            "    vvll invNexts(nexts.size());",
            "    rep(i,nexts.size()){",
            "        for(ll next: nexts[i]){",
            "            invNexts[next].push_back(i);",
            "        }",
            "    }",
            "",
            "    //帰りがけ順で記録していくやつ",
            "    ll order = 0;",
            "    ll sccId = 0;",
            "    ",
            "    vll orders(nexts.size());",
            "    vb visitIki(nexts.size(), false);",
            "    std::function<void(ll)> scc1 = [&](ll now){",
            "        visitIki[now] = true;",
            "        for(ll next: nexts[now]){",
            "            if(visitIki[next]) continue;",
            "            scc1(next);",
            "        }",
            "        ",
            "        orders[now] = order++;",
            "    };",
            "    std::function<void(ll)> scc2 = [&](ll now){",
            "        sccIds[now] = sccId;",
            "        for(ll next: invNexts[now]){",
            "            if(sccIds[next] != -1) continue;",
            "            scc2(next);",
            "        }",
            "    };",
            "    //全部の頂点について、そこから行けるところのorderを全部記録する",
            "    rep(i, nexts.size()) if(visitIki[i] == false) scc1(i);",
            "",
            "    //{帰りがけのOrder、index}のペアを降順にソート",
            "    vpll orderIds(nexts.size());",
            "    rep(i,nexts.size()) orderIds[i] = {orders[i], i};",
            "    sort(all(orderIds));",
            "    reverse(all(orderIds));",
            "",
            "    rep(i,nexts.size()) if(sccIds[orderIds[i].second] == -1){",
            "        scc2(orderIds[i].second);",
            "        sccId++;",
            "    } ",
            "    return sccIds;",
            "}",
        ]
    },
    "kruskal":{
        "prefix": "sni_kruskal",
        "body": [
            "struct UnionFind {",
            "public:",
            "    vll par; // par[i]:iの親の番号　(例) par[3] = 2 : 3の親が2",
            "    vll kosu;",
            "    ll Count; //全体として何個の集合があるか",
            "    ",
            "    UnionFind(ll n) : par(n),kosu(n),Count(n) { //最初は全てが根であるとして初期化",
            "        rep(i,n){",
            "            par[i] = i;",
            "            kosu[i] = 1;",
            "        }",
            "    }",
            "",
            "    ll root(ll x) { // データxが属する木の根を再帰で得る：root(x) = {xの木の根}",
            "        if (par[x] == x) return x;",
            "        return par[x] = root(par[x]);",
            "    }",
            "",
            "    void unite(ll x, ll y) { // xとyの木を併合",
            "        ll rx = root(x); //xの根をrx",
            "        ll ry = root(y); //yの根をry",
            "        if (rx == ry) return; //xとyの根が同じ(=同じ木にある)時はそのまま",
            "        par[rx] = ry; //xとyの根",
            "        kosu[ry] += kosu[rx];",
            "        Count--;",
            "    }",
            "",
            "    bool same(ll x, ll y) { // 2つのデータx, yが属する木が同じならtrueを返す",
            "        ll rx = root(x);",
            "        ll ry = root(y);",
            "        return rx == ry;",
            "    }",
            "    ",
            "    ll size(ll x){",
            "        return kosu[root(x)];",
            "    }",
            "    ll size(){",
            "        return Count;",
            "    }",
            "};",
            "",
            "//0 ~ N-1までのグラフ（連結）の中で、最小全域木を作る",
            "//costの型$1（基本的にはllかdouble）",
            "//nextsは{cost,index}",
            "//実際の最小コストだけが欲しいときは、戻り値の型をllにして、minCostを返せばいい",
            "vector<vector<pair<$1,ll>>> kruskal(vector<vector<pair<$1,ll>>> &nexts){",
            "    UnionFind uf(nexts.size());",
            "    struct KruskalEdge{",
            "        ll u,v;",
            "        $1 c;",
            "    };",
            "    vector<KruskalEdge> edges;",
            "    rep(i, nexts.size()) for(pair<$1,ll> e: nexts[i]){",
            "        edges.push_back({i, e.second, e.first});",
            "    }",
            "    //trueだったら第1引数が手前に来る",
            "    //p1 < p2として作ると昇順になる",
            "    //p2 < p1として作ると降順になる",
            "    ",
            "    //sort(all(v), compf);みたいに使ってね",
            "    std::function<bool(KruskalEdge&, KruskalEdge&)> compf = [&](const KruskalEdge &p1,const KruskalEdge &p2) {",
            "        return p1.c < p2.c;",
            "    };",
            "    ",
            "    sort(all(edges), compf);",
            "    $1 minCost = 0;",
            "    vector<vector<pair<$1,ll>>> ret(nexts.size());",
            "    rep(i,edges.size()){",
            "        if(!uf.same(edges[i].u, edges[i].v)){",
            "            uf.unite(edges[i].u, edges[i].v);",
            "            minCost += edges[i].c;",
            "            ret[edges[i].u].push_back({edges[i].c, edges[i].v});",
            "        }",
            "    }",
            "    //最小コストだけがほしいならここでminCostを返す",
            "    return ret;",
            "}",
        ]
    },
    "trietree":{
        "prefix": "sni_trietree",
        "body": [
            "//文字列の検索がmax(s_i.size())で可能",
            "//共通接頭辞の数を数えたりできる",
            "class TrieTree{",
            "public:",
            "    ////////////////////////////////",
            "    // 大文字小文字とかの区別はここ //",
            "    ////////////////////////////////",
            "    //mutable型じゃないやつ（stringとか）をconstで初期化しようと思ったらinlineがいるらしい",
            "    static inline const string char_set = \"abcdefghijklmnopqrstuvwxyz\";",
            "    //static inline const string char_set = \"ABCDEFGHIJKLMNOPQRSTUVWXYZ\";",
            "",
            "    //根っこの文字IDは-1にしとく（そのほかはchar_setのindex）",
            "    static const ll root = -1;",
            "",
            "    //Trie木の各頂点",
            "    class Node {",
            "    public:",
            "        vll nextIdx = vll(char_set.size(), -1);      //nextIdx[i] := idがiの文字に行くときのNodeのインデックス（存在しない場合は-1）",
            "        ll charId = -1;           //今のnodeにある文字ID（'a'なら0みたいな）",
            "        ll wordCountFuture = 0;   //この下にいくつ単語があるか(自分も含む)",
            "        ll wordCount = 0;    //ここで止まる単語がいくつあるか",
            "",
            "        Node(ll c){ charId = c; }",
            "        Node(){}",
            "    };",
            "    ",
            "    ",
            "    vector<Node> nodes;     // 頂点集合",
            "    map<char,ll> charToId;  // 各文字をIDに変換する",
            "",
            "    //rootの追加と、charToIdの設定",
            "    TrieTree(){",
            "        nodes.push_back(Node(root));",
            "        rep(i,char_set.size()) charToId[char_set[i]] = i;",
            "    }",
            "    ",
            "    //単語の追加",
            "    void insert(const string &word){",
            "        //rootは必ず0番目になる",
            "        ll index = 0;",
            "",
            "        //rootについてもFutureをカウントしとく（全体でのsizeを出すため）",
            "        nodes[index].wordCountFuture++;",
            "",
            "        rep(i,word.size()){",
            "            ll cid = charToId[word[i]];",
            "            //今のindexから文字cidに行くパスがなければ追加する",
            "            if(nodes[index].nextIdx[cid] == -1){",
            "                nodes[index].nextIdx[cid] = nodes.size();",
            "                index = nodes.size();",
            "                nodes.push_back(Node(cid));",
            "            }",
            "            //cidに行ければ行く",
            "            else{",
            "                index = nodes[index].nextIdx[cid];",
            "            }",
            "            //ここを通ったということは、この先にあるということ",
            "            nodes[index].wordCountFuture++;",
            "        }",
            "        nodes[index].wordCount++;",
            "    }",
            "",
            "    //全部で単語がいくつあるか？",
            "    ll size(){",
            "        return nodes[0].wordCountFuture;",
            "    }",
            "",
            "    //この単語がいくつあるか？",
            "    ll countWord(const string &word){",
            "        ll index = 0;",
            "        rep(i,word.size()){",
            "            ll cid = charToId[word[i]];",
            "            if(nodes[index].nextIdx[cid] == -1) return 0;",
            "            index = nodes[index].nextIdx[cid];",
            "        }",
            "        return nodes[index].wordCount;",
            "    }",
            "",
            "    //これをprefixにもつ単語がいくつあるか？（自分含めて）",
            "    ll countWordFuture(const string &word, bool includeMe=true){",
            "        ll index = 0;",
            "        rep(i,word.size()){",
            "            ll cid = charToId[word[i]];",
            "            if(nodes[index].nextIdx[cid] == -1) return 0;",
            "            index = nodes[index].nextIdx[cid];",
            "        }",
            "        if(includeMe) return nodes[index].wordCountFuture;",
            "        else return nodes[index].wordCountFuture - nodes[index].wordCount;",
            "    }",
            "",
            "    //この文字列の接頭辞がいくつあるか？（自分含め）",
            "    //atcoderに対してatやatcなどがいくつあるか？（デフォルトは重複も数える）",
            "    ll countPrefix(const string &word, bool isCountDuplication=true) {",
            "        ll index = 0;",
            "        ll ret = 0;",
            "        rep(i,word.size()){",
            "            ll cid = charToId[word[i]];",
            "            if(nodes[index].nextIdx[cid] == -1) return ret;",
            "            index = nodes[index].nextIdx[cid];",
            "            if(isCountDuplication) ret += nodes[index].wordCount;",
            "            else ret += (nodes[index].wordCount>0?1:0);",
            "        }",
            "        return ret;",
            "    }",
            "};",
        ]
    },
